---
// Cookie consent banner: GA loads only after affirmative consent.
// Consent state is stored in localStorage (exempt storage — it holds
// nothing but the consent record itself).
interface Props {
  gaId: string;
}
const { gaId } = Astro.props;
---

<div id="consent-banner" class="hidden fixed bottom-0 left-0 right-0 z-50 p-4">
  <div class="mx-auto max-w-3xl p-6 rounded-md shadow-xl bg-white dark:bg-slate-800 dark:border dark:border-slate-600 dark:shadow-none">
    <p class="text-muted text-sm md:text-base">
      This site uses Google Analytics to understand how it's used — pages viewed, approximate location, device type.
      Analytics only runs if you accept. No advertising, no accounts, nothing else tracked. See the
      <a href="/privacy" class="underline hover:text-primary">Privacy Policy</a>.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 mt-4">
      <button type="button" id="consent-accept" class="btn-primary text-sm py-2 px-5">Accept analytics</button>
      <button type="button" id="consent-decline" class="btn-secondary text-sm py-2 px-5">Decline</button>
    </div>
  </div>
</div>

<script define:vars={{ gaId }}>
  const KEY = 'ms-analytics-consent';
  const banner = document.getElementById('consent-banner');

  const grant = () => {
    localStorage.setItem(KEY, 'granted');
    loadGa();
    hide();
  };
  const decline = () => {
    localStorage.setItem(KEY, 'denied');
    hide();
  };
  const hide = () => banner?.classList.add('hidden');

  const loadGa = () => {
    // Idempotent: guards against double-loading on revisits.
    if (document.getElementById('ga-post-consent')) return;
    const s = document.createElement('script');
    s.id = 'ga-post-consent';
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    window.gtag('js', new Date());
    // Default: everything denied until granted.
    window.gtag('consent', 'default', { ad_storage: 'denied', analytics_storage: 'denied' });
    window.gtag('consent', 'update', { analytics_storage: 'granted' });
    window.gtag('config', gaId, { anonymize_ip: true });
  };

  const init = () => {
    const saved = localStorage.getItem(KEY);
    if (saved === 'granted') loadGa();
    else if (!saved) banner?.classList.remove('hidden');
  };

  document.getElementById('consent-accept')?.addEventListener('click', grant);
  document.getElementById('consent-decline')?.addEventListener('click', decline);

  init();
</script>
