---
import { SITE } from 'astrowind:config';
---

<style>
  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('/fonts/ibm-plex-sans-latin-600.woff2') format('woff2');
  }
</style>

<span
  class="h-8 self-center text-xl font-semibold tracking-tight text-default dark:text-white"
  style="font-family: 'IBM Plex Sans', 'Inter', ui-sans-serif, system-ui, sans-serif;"
>
  {SITE?.name}
</span>
