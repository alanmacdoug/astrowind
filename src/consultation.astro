---
import Layout from '~/layouts/PageLayout.astro';

import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'Book a Consultation',
  description:
    'Book a free consultation about your email deliverability. Tell me what is happening and what your domain is — the first conversation costs nothing.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

  <Hero
    tagline="Consultation"
    title="Book your free consultation"
    subtitle="Thirty minutes, no charge, no obligation. Tell me what is happening with your email and which domain it concerns — I will look at what I can before we speak, so the conversation starts with substance rather than a discovery call."
    compact={true}
  />

  <!-- The booking form (slate-100) -->

  <section id="consultation" class="relative bg-slate-100 dark:bg-transparent">
    <div class="px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
      <div
        class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 sm:p-8"
      >
        <form id="consultation-form" class="space-y-6" method="POST" action="/api/contact">
          <!-- Hidden routing fields -->

          <input type="hidden" name="source" value="consultation" />
          <input type="hidden" name="page" value="/consultation" />

          <!-- Honeypot -->

          <div class="hidden" aria-hidden="true">
            <label for="company-website">Company website</label>
            <input
              id="company-website"
              type="text"
              name="_gotcha"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">Your name</span>
              <input
                type="text"
                name="name"
                required
                autocomplete="name"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              />
            </label>

            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">Email address</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              />
            </label>
          </div>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">The domain we will be talking about</span>
            <input
              type="text"
              name="domain"
              placeholder="example.com"
              autocomplete="off"
              spellcheck="false"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <span class="block text-xs text-slate-500 dark:text-slate-400 mt-1.5">
              Optional but strongly recommended. I can check a great deal from public DNS before we speak.
            </span>
          </label>

          <div>
            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">What is happening?</span>
              <textarea
                name="message"
                rows="6"
                required
                placeholder="A paragraph or two. Email going to spam, bounces climbing after a migration, planning a new platform, invoices not arriving — whatever the situation, describe it plainly."
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              ></textarea>
            </label>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">
              The more specific the description, the more useful the first conversation. "Email is broken" is workable; "since we moved to our new CRM in March, marketing mail lands in spam but invoices arrive" is better.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">What sends email for you today?</span>
              <select
                name="sending-setup"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              >
                <option value="">Select the closest fit…</option>
                <option value="single-esp">One platform (Mailchimp, Klaviyo, etc.)</option>
                <option value="multiple-esp">Several platforms</option>
                <option value="self-hosted">Self-hosted (Mautic, Postal, own server)</option>
                <option value="mixed">Mix of platforms and self-hosted</option>
                <option value="unsure">Not sure / still deciding</option>
              </select>
            </label>

            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">Approximate monthly send volume</span>
              <select
                name="volume"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              >
                <option value="">Select the closest fit…</option>
                <option value="under-1k">Under 1,000</option>
                <option value="1k-10k">1,000 – 10,000</option>
                <option value="10k-50k">10,000 – 50,000</option>
                <option value="50k-plus">50,000+</option>
              </select>
            </label>
          </div>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Anything you want looked at specifically?</span>
            <input
              type="text"
              name="focus"
              placeholder="e.g. DMARC reports, a bounce spike, a migration we are planning"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>

          <button
            type="submit"
            id="submit-btn"
            class="btn btn-primary font-medium rounded-lg px-6 py-3 w-full sm:w-auto"
          >
            Book Consultation
          </button>

          <div id="form-status" class="hidden rounded-lg border p-4 text-sm"></div>
        </form>

        <p class="relative text-center text-xs text-slate-600 dark:text-slate-400 mt-4">
          Goes straight to my inbox. One reply within one working day to arrange a time — no sequences, no pitch deck.
        </p>
      </div>
    </div>
  </section>

  <!-- What happens next -->

  <section class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold dark:text-white">What happens after you submit</h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
        No waiting rooms and no discovery-call theatre.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4">
      <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
        <h3 class="font-bold text-lg dark:text-white">1. I read your domain before we speak</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          If you provide the domain, I check the public-facing posture first — SPF, DKIM, DMARC, MX. Thirty minutes on the call then starts with findings rather than questions.
        </p>
      </div>
      <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
        <h3 class="font-bold text-lg dark:text-white">2. The conversation is about diagnosis</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          What is broken, why it is probably broken, and roughly what fixing it involves. If it is a two-hour self-fix, that gets said.
        </p>
      </div>
      <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
        <h3 class="font-bold text-lg dark:text-white">3. You decide what happens next</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          If the problem needs more than a conversation, the follow-on work is the £150 audit. There is no obligation to take it, and no drip campaign either way.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Check Your Domain First', href: '/tools/auth-checker' },
    ]}
    title="Want to go in prepared?"
    subtitle="Run the authentication checker on your domain before the call, and bring the results. It is the same first step the consultation uses."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </CallToAction>

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<script>
  // --- Consultation Booking — v1.0 -------------------------------------------
  // Posts to the existing /api/contact Worker (KV + email notification).
  // Distinguished from the general contact form by source=consultation.
  // Submit intercepted for AJAX-style status handling with graceful
  // fallback: if JS fails, the native POST still delivers.
  // Uses the site-wide window.pageInit pattern for View Transitions.

  function init() {
    const form = document.getElementById('consultation-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('form-status');
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (!form || !statusEl || !btn) return;
    if (form.dataset.initDone === 'true') return;
    form.dataset.initDone = 'true';

    function setStatus(kind: 'ok' | 'error', text: string) {
      statusEl.classList.remove('hidden');
      statusEl.className =
        kind === 'ok'
          ? 'rounded-lg border border-emerald-200 dark:border-emerald-700 bg-emerald-50 dark:bg-emerald-900/20 p-4 text-sm text-emerald-800 dark:text-emerald-300'
          : 'rounded-lg border border-red-200 dark:border-red-700 bg-red-50 dark:bg-red-900/20 p-4 text-sm text-red-800 dark:text-red-300';
      statusEl.textContent = text;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot check: if filled, pretend success and drop the submission
      const honeypot = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
      if (honeypot && honeypot.value !== '') {
        setStatus('ok', 'Thank you. Your booking request has been received.');
        return;
      }

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        if (res.ok) {
          setStatus(
            'ok',
            'Received. I will reply within one working day to arrange a time. If you provided a domain, I will have looked at its public DNS before we speak.',
          );
          form.reset();
        } else {
          setStatus(
            'error',
            'Something went wrong sending the form — status ' + res.status + '. Please try again in a moment, or use the general contact page.',
          );
        }
      } catch {
        setStatus(
          'error',
          'The request could not be sent. Check your connection and try again, or use the general contact page.',
        );
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });
  }

  const pageInit = (window as any).pageInit as ((fn: () => void) => void) | undefined;
  if (typeof pageInit === 'function') {
    pageInit(init);
  } else {
    init();
    document.addEventListener('astro:page-load', init);
  }
</script>
