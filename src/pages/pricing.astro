---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pricing',
  description:
    'Clear pricing for email infrastructure work: fixed-scope audits, hourly consulting, and monthly managed services. No hidden costs.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText -->

  <HeroText
    tagline="Pricing"
    title="Know what it costs before you commit"
    subtitle="Project work is priced up front and fixed. Ongoing work is scoped to what you need — and cancellable with notice."
  />

  <!-- Pricing -->

  <Prices
    title="Ways to work together"
    subtitle="Every engagement starts the same way: a free conversation, then a fixed price"
    prices={[
      {
        title: 'Authentication Audit',
        subtitle: 'One-off diagnostic, fixed price',
        price: { monthly: 150 },
        period: { monthly: 'fixed price, from' },
        items: [
          { description: 'Full SPF, DKIM and DMARC review' },
          { description: 'Plain-English findings report' },
          { description: 'Prioritised fix list with costs' },
          { description: 'Typical turnaround: 3 working days' },
        ],
        callToAction: {
          text: 'Book an audit',
          href: '#contact',
        },
      },
      {
        title: 'Managed & Monitored',
        subtitle: 'Monthly, for business-critical email',
        price: { monthly: 75 },
        period: { monthly: 'per month, from' },
        note: 'Scope agreed up front — cancel with [X] months notice',
        highlight: true,
        items: [
          { description: 'Managed Mautic hosting and maintenance' },
          { description: 'DNS drift and blacklist monitoring' },
          { description: 'DMARC report review' },
          { description: 'Defined response windows' },
          { description: 'Scheduled deliverability health checks' },
        ],
        callToAction: {
          text: 'Discuss ongoing work',
          href: '#contact',
        },
        hasRibbon: true,
        ribbonTitle: 'most clients',
      },
      {
        title: 'Consulting',
        subtitle: 'Advisory and project work by the hour',
        price: { monthly: 35 },
        period: { monthly: 'per hour' },
        items: [
          { description: 'Platform strategy and migrations' },
          { description: 'Automation architecture' },
          { description: 'Second opinions on proposals' },
          { description: 'Booked in blocks as needed' },
        ],
        callToAction: {
          text: 'Ask about availability',
          href: '#contact',
        },
      },
    ]}
  />

  <!-- Steps -->

  <Steps
    title="How a price becomes fixed"
    tagline="no surprises"
    items={[
      {
        title: 'Free conversation',
        description: `We talk about your problem and what “done” looks like. No charge, no obligation.`,
        icon: 'tabler:message-report',
      },
      {
        title: 'Survey',
        description: `I investigate your setup — DNS, authentication, sending platforms — before quoting anything.`,
        icon: 'tabler:search',
      },
      {
        title: 'Quote, fixed',
        description: `Written scope and price, agreed before any work begins. If it changes, you approve it first.`,
        icon: 'tabler:file-text',
      },
      {
        title: 'Verify, then invoice',
        description: `You see the evidence the work is done before the invoice arrives.`,
        icon: 'tabler:checkup-list',
      },
    ]}
  />

  <!-- FAQs -->

  <FAQs
    title="Pricing questions"
    subtitle="The ones that come up before the first call."
    columns={1}
    items={[
      {
        title: 'Why does the audit have a range, not one price?',
        description:
          'Simple single-domain setups sit at the bottom of the range. Multiple sending platforms, complicated DNS history or large domains take longer to survey properly. The exact price is quoted after the free initial conversation — before you commit to anything.',
      },
      {
        title: 'Are there hidden costs after the audit?',
        description:
          'No. The report tells you what is wrong and how to fix it. If you want me to implement the fixes, that is a separate, separately-priced piece of work — quoted and agreed before it starts.',
      },
      {
        title: 'How is ongoing work billed?',
        description:
          'Monthly, in advance, for the agreed scope. Retainers are cancellable with notice — the arrangement should stay because it earns its keep, not because it is trapped.',
      },
      {
        title: 'What currencies and methods?',
        description:
          '[DECIDE: GBP invoicing via bank transfer and Upwork escrow; retainers by standing order. Square this with your Upwork rate before publishing.]',
      },
      {
        title: 'Can we start small?',
        description:
          'Most engagements start with an audit. It gives you a clear picture of where you stand, and gives us both a low-risk way to see whether the ongoing relationship makes sense.',
      },
    ]}
  />

  <!-- CTA -->

  <CallToAction
    title="Still deciding?"
    subtitle="A conversation costs nothing — and a deliverability problem costs you quietly every day."
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/UPWORK_URL',
      },
      { variant: 'secondary', text: 'Email me direct', href: 'mailto:alan@macdougallsystems.com' },
    ]}
  />
</Layout>
