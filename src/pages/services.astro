---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Layout from '~/layouts/PageLayout.astro';

import { getPermalink } from '~/utils/permalinks';

import servicesMonitoring from '~/assets/images/services-monitoring.jpg';

const metadata = {
  title: 'Services',
  description:
    'Email authentication audits, deliverability rescue, managed Mautic hosting and ActiveCampaign consulting. Clear scope, fixed prices where possible, evidence at every step.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

  <Hero
    tagline="Services"
    title="Email infrastructure, handled properly"
    subtitle="Fixed-scope audits and rescues when something's broken. Ongoing management when you'd rather never think about it again. Twenty years' experience in both."
    actions={[
      {
        variant: 'primary',
        text: 'Free consultation',
        href: getPermalink('/contact'),
      },
      { variant: 'secondary', text: 'Free tools', href: getPermalink('/tools') },
    ]}
  />

  <!-- Project work -->

  <Features2
    title="Service examples"
    subtitle="Defined scope and clear deliverables. Targeted services, starting with a no obligation conversation."
    columns={3}
    items={[
      {
        title: 'Email authentication audit',
        description:
          'A full review of your SPF, DKIM and DMARC records and sending setup, with a plain-English report of what is broken, what it is costing you, and exactly how to fix it. Typical turnaround: three working days.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Deliverability rescue',
        description:
          "Your email goes to spam and you're not sure why. I diagnose the cause — authentication, reputation, list hygiene, content, infrastructure — and fix it. Fix verified with evidence before the job closes.",
        icon: 'tabler:mail-forward',
      },
      {
        title: 'Authentication implementation',
        description:
          'SPF, DKIM and DMARC built correctly from the start, across your sending platforms, with DMARC monitoring until enforcement is safe. Compliance with all sender requirements and best practices.',
        icon: 'tabler:route',
      },
      {
        title: 'Migrations & platform setup',
        description:
          'Moving house: between ESPs or into a self-hosted setup. Segments, templates, automations and authentication carried over and verified.',
        icon: 'tabler:settings-cog',
      },
      {
        title: 'Marketing automation architecture',
        description:
          'Automation flows, drip campaigns and list strategy designed by someone who has run these systems in production for 2 decades — not just configured them.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Sending infrastructure',
        description:
          'Relay setup, reputation management and transactional/marketing stream separation for businesses sending at any volume. The right provider for your volumes and budget, not the default one.',
        icon: 'tabler:server',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Ongoing work -->

  <Content
    isReversed
    image={{
      src: servicesMonitoring,
      alt: 'A monitoring workstation with three screens showing email deliverability dashboards in soft indigo light',
      aspect: 'auto',
    }}
    items={[
      {
        title: 'Managed Mautic hosting',
        description:
          'Your own self-hosted marketing automation, on infrastructure I administer. Updates, monitoring, deliverability and authentication maintained — without you running a server.',
        icon: 'tabler:server',
      },
      {
        title: 'Monitoring & maintenance',
        description:
          'DNS error detection, blacklist monitoring and DMARC report review, with defined response windows. Problems caught before your sender reputation pays for them.',
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Ongoing consulting',
        description:
          'A monthly relationship for businesses whose email is business-critical: advisory, changes, and someone to call when something looks wrong.',
        icon: 'tabler:message-report',
      },
      {
        title: 'Campaign support',
        description:
          'Landing pages, campaign sends and setup work for clients on monthly services or recurring engagements.',
        icon: 'tabler:article',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Ongoing management</h3>
      <p>
        Some problems are projects. Some are just work that has to keep happening. Ongoing service engagements are billed
        monthly, scoped to what you actually need, and cancellable with 30 days notice — the relationship should stay only
        because it earns its keep.
      </p>
    </Fragment>
  </Content>

  <!-- Process -->

 <Steps
    id="process"
    title="How I SERVE every client"
    subtitle="A defined process, agreed before anything changes — the same discipline for a one-off audit or for ongoing services."
    items={[
      {
        title: 'Survey <span class="font-normal">— consultation & investigation</span>',
        description: `We start with a conversation, then a technical survey of your current setup: DNS, authentication records, sending platforms, list hygiene. No proposals before diagnosis.`,
        icon: 'tabler:search',
      },
      {
        title: 'Explain <span class="font-normal">— findings in plain English</span>',
        description: `You receive a clear picture of what's wrong, what it's costing you, and what fixing it involves. Scope and price are agreed before any changes are made.`,
        icon: 'tabler:message-report',
      },
      {
        title: 'Remediate <span class="font-normal">— implementation</span>',
        description: `The agreed work, done properly: authentication records aligned, systems configured, deliverability repaired. Changes documented as they're made.`,
        icon: 'tabler:tools',
      },
      {
        title: 'Verify <span class="font-normal">— proof it works</span>',
        description: `Tests and reports demonstrating the result — authenticated mail, passing checks, measurable improvement. You see the evidence, not just my word.`,
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Engage <span class="font-normal">— ongoing relationship</span>',
        description: `Where it makes sense: monitoring, maintenance and defined response windows, so problems are caught before your sender reputation pays for them.`,
        icon: 'tabler:users',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Steps>

  <!-- CTA -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a Free Consultation',
        href: getPermalink('/contact'),
      },
      { variant: 'secondary', text: 'Explore Free Tools', href: getPermalink('/tools') },
    ]}
    title="Ready to solve your email problems?"
    subtitle="Book your free consultation or self test your email setup with free tools."
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and commentary on authentication, deliverability and overall strategy — the questions clients ask, answered in the blog."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
