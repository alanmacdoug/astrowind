---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Layout from '~/layouts/PageLayout.astro';

import servicesMonitoring from '~/assets/images/services-monitoring.jpg';

const metadata = {
  title: 'Services',
  description:
    'Email authentication audits, deliverability rescue, managed Mautic hosting and ActiveCampaign consulting. Clear scope, fixed prices where possible, evidence at every step.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

  <Hero
    tagline="Services"
    title="Email infrastructure, handled properly"
    subtitle="Fixed-scope audits and rescues when something's broken. Ongoing management when you'd rather never think about it again. Twenty years' experience in both."
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/UPWORK_URL',
      },
      { variant: 'secondary', text: 'Email me direct', href: 'mailto:alan@macdougallsystems.com' },
    ]}
  />

  <!-- Project work -->

  <Features2
    title="Project work"
    subtitle="Defined scope, fixed price, clear deliverable. Booked through Upwork or direct."
    columns={3}
    items={[
      {
        title: 'Email authentication audit',
        description:
          'A full review of your SPF, DKIM and DMARC records and sending setup, with a plain-English report of what is broken, what it is costing you, and exactly how to fix it. Typical turnaround: three working days.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Deliverability rescue',
        description:
          'Your email lands in spam and nobody can tell you why. I diagnose the cause — authentication, reputation, list hygiene, content, infrastructure — and fix it. Verified with evidence before the job closes.',
        icon: 'tabler:mail-forward',
      },
      {
        title: 'Authentication implementation',
        description:
          'SPF, DKIM and DMARC built correctly from the start, across your sending platforms, with DMARC monitoring until enforcement is safe. Compliance with Gmail, Outlook and Yahoo sender requirements.',
        icon: 'tabler:route',
      },
      {
        title: 'Migrations & platform setup',
        description:
          'Moving house: between ESPs, into ActiveCampaign, out of a broken self-hosted setup. Segments, templates, automations and authentication carried over and verified.',
        icon: 'tabler:settings-cog',
      },
      {
        title: 'Marketing automation architecture',
        description:
          'Automation flows, drip campaigns and list strategy designed by someone who has run these systems in production for years — not just configured them.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Sending infrastructure',
        description:
          'Relay setup, reputation management and transactional/marketing stream separation for businesses sending at volume. The right provider for your volumes and budget, not the default one.',
        icon: 'tabler:server',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Ongoing work -->

  <Content
    isReversed
    image={{
      src: servicesMonitoring,
      alt: 'A monitoring workstation with three screens showing email deliverability dashboards in soft indigo light',
      aspect: 'auto',
    }}
    items={[
      {
        title: 'Managed Mautic hosting',
        description:
          'Your own self-hosted marketing automation, on infrastructure I administer. Updates, monitoring, deliverability and authentication maintained — without you running a server.',
        icon: 'tabler:server',
      },
      {
        title: 'Monitoring & maintenance',
        description:
          'DNS drift detection, blacklist monitoring and DMARC report review, with defined response windows. Problems caught before your sender reputation pays for them.',
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Ongoing consulting',
        description:
          'A monthly relationship for businesses whose email is business-critical: advisory, changes, and someone to call when something looks wrong.',
        icon: 'tabler:message-report',
      },
      {
        title: 'Campaign support',
        description:
          'Landing pages, campaign sends and setup work for clients on retainers or recurring engagements.',
        icon: 'tabler:article',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Ongoing management</h3>
      <p>
        Some problems are projects. Some are just work that has to keep happening. Retainer engagements are billed
        monthly, scoped to what you actually need, and cancellable with notice — because the relationship should stay
        because it earns its keep.
      </p>
    </Fragment>
  </Content>

  <!-- Process -->

  <Steps
    title="Every engagement, the same way"
    subtitle="However large or small the job: Survey, Explain, Remediate, Verify, Engage."
    columns={3}
    items={[
      {
        title: 'Survey & Explain',
        description: `Investigate first, then findings and a fixed price in plain English — agreed before anything changes.`,
        icon: 'tabler:search',
      },
      {
        title: 'Remediate',
        description: `The agreed work, done properly and documented as it happens.`,
        icon: 'tabler:tools',
      },
      {
        title: 'Verify & Engage',
        description: `Proof it works — tests and reports you can see. Then, where it makes sense, the ongoing relationship.`,
        icon: 'tabler:checkup-list',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Steps>

  <!-- CTA -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/UPWORK_URL',
      },
      { variant: 'secondary', text: 'Email me direct', href: 'mailto:alan@macdougallsystems.com' },
    ]}
    title="Tell me where your email is landing"
    subtitle="An audit starts at £150. A conversation is free."
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Field notes from two decades of email infrastructure: authentication explained, deliverability debugged, and the occasional hard-won lesson committed to writing."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
