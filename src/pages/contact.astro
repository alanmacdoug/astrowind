---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

import { getPermalink } from '~/utils/permalinks';

import contactDoor from '~/assets/images/contact-door.jpg';

const metadata = {
  title: 'Contact',
  description:
    'Get in touch with MacDougall Systems about email authentication, deliverability, managed hosting or consulting.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Contact"
    title="Tell me where your email is landing"
    subtitle="Describe the problem in a paragraph or two — what's going wrong, what platform you send from, and roughly how many emails per month. I'll tell you straight whether it's something I can fix and what it will cost."
    actions={[
      {
        variant: 'primary',
        text: 'Email me direct',
        href: 'mailto:alan@macdougallsystems.com',
      },
      { variant: 'secondary', text: 'Explore free tools', href: getPermalink('/tools') },
    ]}
  />

  <!-- Contact form -->

  <section class="relative not-prose" id="contact-form-section" aria-labelledby="contact-form-heading">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="mx-auto max-w-2xl px-4 md:px-6 py-12 md:py-16 text-default">
      <div class="mx-auto p-6 md:p-8 rounded-md shadow-xl dark:border dark:border-slate-600 dark:shadow-none">
        <h2 id="contact-form-heading" class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Send a message</h2>
        <p class="text-muted mt-4 mb-8 text-xl">Fill this in and it lands in my inbox — same one-working-day reply as email.</p>
        <form id="contact-form" class="grid gap-6" novalidate>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="cf-name" class="block text-sm font-medium mb-2">Name</label>
              <input type="text" id="cf-name" name="name" required maxlength="200" autocomplete="name"
                class="w-full rounded-md border border-slate-300 dark:border-slate-700 bg-transparent px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
            </div>
            <div>
              <label for="cf-email" class="block text-sm font-medium mb-2">Email</label>
              <input type="email" id="cf-email" name="email" required maxlength="200" autocomplete="email"
                class="w-full rounded-md border border-slate-300 dark:border-slate-700 bg-transparent px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
            </div>
          </div>
          <div>
            <label for="cf-message" class="block text-sm font-medium mb-2">Message</label>
            <textarea id="cf-message" name="message" rows="6" required maxlength="5000"
              class="w-full rounded-md border border-slate-300 dark:border-slate-700 bg-transparent px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"></textarea>
          </div>
          <div class="hidden" aria-hidden="true">
            <label for="cf-website">Leave this field empty</label>
            <input type="text" id="cf-website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div>
            <button type="submit" id="cf-submit" class="btn-primary w-full sm:w-auto">Send message</button>
            <p id="form-status" class="text-muted mt-4 text-sm hidden" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <Content
    isReversed
    image={{
      src: contactDoor,
      alt: 'A brass letterbox in a slate-grey door with a soft envelope glowing in the slot',
      aspect: 'auto',
    }}
    items={[
      {
        title: 'Email',
        description:
          'alan@macdougallsystems.com — for consultations, retainers, managed hosting and everything booked direct. I aim to reply within one working day.',
        icon: 'tabler:mail',
      },
      {
        title: 'Free tools',
        description:
          "Run a free check on your own domain's authentication records first — results in seconds, nothing to book.",
        icon: 'tabler:tool',
      },
      {
        title: 'What happens next',
        description:
          'I reply with questions, you answer them, and you get a fixed price before anything changes. No surprises, no hourly creep.',
        icon: 'tabler:route',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">How to reach me</h3>
      <p>
        One door, no middlemen. Everything comes straight to me — consultations, audits, retainers, managed Mautic
        hosting — and you work with the same person throughout, start to finish.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Email me direct',
        href: 'mailto:alan@macdougallsystems.com',
      },
      { variant: 'secondary', text: 'Explore free tools', href: getPermalink('/tools') },
    ]}
    title="A conversation is free"
    subtitle="Describe the problem. If I can fix it, you'll know what it costs before you commit."
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Field notes from two decades of email infrastructure: authentication explained, deliverability debugged, and the occasional hard-won lesson committed to writing."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status') as HTMLParagraphElement;
  const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const fd = new FormData(form);
    const payload = {
      name: String(fd.get('name') ?? '').trim(),
      email: String(fd.get('email') ?? '').trim(),
      message: String(fd.get('message') ?? '').trim(),
      website: String(fd.get('website') ?? ''),
    };

    const setError = (msg: string) => {
      statusEl.textContent = msg;
      statusEl.classList.remove('hidden');
    };

    if (!payload.name || !payload.email || !payload.message) {
      setError('Please fill in your name, email and message.');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json().catch(() => ({ ok: false }))) as { ok: boolean; notActive?: boolean; error?: string };

      if (data.ok) {
        form.innerHTML = '<p class="text-xl">Message sent. Thanks — I will get back to you within one working day.</p>';
      } else if (data.notActive) {
        setError('Sending is not switched on yet. Please email alan@macdougallsystems.com directly for now.');
      } else if (data.error === 'email') {
        setError('That email address does not look right — please check it and try again.');
      } else {
        setError('Something went wrong sending that. Please email alan@macdougallsystems.com directly.');
      }
    } catch {
      setError('Network problem — please try again, or email alan@macdougallsystems.com directly.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send message';
    }
  });
</script>
