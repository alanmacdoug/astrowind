---
import Layout from '~/layouts/PageLayout.astro';

import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'ROI Calculator',
  description:
    'Estimate what poor email deliverability and weak open rates cost your business each month — list size, rates and customer value in, honest numbers out.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

  <Hero
    tagline="Tools"
    title="What is poor email performance costing you?"
    subtitle="Enter your numbers and see the revenue leaking away through two holes: mail landing in spam, and mail that lands but never gets opened. Conservative maths, every assumption shown — nothing hidden."
  />

  <!-- The calculator (slate-100) -->

  <section id="roi-calculator" class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>

    <div
      class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 sm:p-8"
    >
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label class="sm:col-span-2 block">
          <span class="block text-sm font-medium dark:text-white mb-1">Industry (pre-fills typical rates)</span>
          <select
            id="industry"
            class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          >
            <option value="other">Other / not sure</option>
            <option value="retail">Retail & ecommerce</option>
            <option value="saas">SaaS / software</option>
            <option value="agency">Agency / consulting</option>
            <option value="nonprofit">Nonprofit</option>
          </select>
        </label>

        <label class="block">
          <span class="block text-sm font-medium dark:text-white mb-1">List size (subscribers)</span>
          <input
            id="list-size"
            type="number"
            min="1"
            value="5000"
            class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </label>

        <label class="block">
          <span class="block text-sm font-medium dark:text-white mb-1">Emails per subscriber per month</span>
          <input
            id="send-frequency"
            type="number"
            min="0.5"
            step="0.5"
            value="4"
            class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </label>

        <div class="sm:col-span-1">
          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Open rate (%)</span>
            <input
              id="open-rate"
              type="number"
              min="0"
              max="100"
              step="0.1"
              value="22"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>
          <p id="open-benchmark-note" class="text-xs text-slate-500 dark:text-slate-400 mt-1.5"></p>
        </div>

        <label class="block">
          <span class="block text-sm font-medium dark:text-white mb-1">Click rate (% of opens)</span>
          <input
            id="click-rate"
            type="number"
            min="0"
            max="100"
            step="0.1"
            value="2.5"
            class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </label>

        <label class="block">
          <span class="block text-sm font-medium dark:text-white mb-1">Conversion rate (% of clicks)</span>
          <input
            id="conversion-rate"
            type="number"
            min="0"
            max="100"
            step="0.1"
            value="2"
            class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </label>

        <label class="block">
          <span class="block text-sm font-medium dark:text-white mb-1">Customer value (£)</span>
          <input
            id="customer-value"
            type="number"
            min="1"
            value="60"
            class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </label>

        <label class="sm:col-span-2 flex items-start gap-3 mt-1">
          <input id="unknown-loss" type="checkbox" class="mt-1 h-4 w-4" />
          <span class="text-sm text-slate-600 dark:text-slate-300">
            I don't know how much of my mail lands in spam — estimate it for me (uses an industry-typical 15%
            inbox loss)
          </span>
        </label>

        <div id="loss-input-wrapper" class="block">
          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Mail failing to reach the inbox (%)</span>
            <input
              id="inbox-loss"
              type="number"
              min="0"
              max="100"
              step="0.5"
              value="15"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>
        </div>
      </div>

      <button
        type="button"
        id="calc-button"
        class="btn btn-primary font-medium rounded-lg px-6 py-3 mt-6 w-full sm:w-auto"
      >
        Calculate
      </button>

      <div id="results" class="mt-8"></div>
    </div>

    <p class="relative text-center text-xs text-slate-500 dark:text-slate-400 mt-4">
      Runs entirely in your browser — nothing is sent or stored. Industry pre-fill and achievable-open figures
      are rough placeholders for demonstration and should not be treated as sourced benchmarks.
    </p>
  </section>

  <!-- More tools (white — alternates against the calculator's slate-100) -->

  <section id="more-tools" class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold dark:text-white">More tools</h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
        Free, browser-based, nothing to sign up for.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href="/tools"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Email authentication checker</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Check any domain's SPF, DKIM and DMARC — records shown, interpreted in plain English.
        </p>
      </a>
      <a
        href="/mautic-cost-comparison"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Mautic vs ESP cost comparison</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Managed Mautic against typical ESP pricing — find the subscriber count where the crossover happens.
        </p>
      </a>
    </div>
  </section>

  <!-- CTA -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/UPWORK_URL',
      },
      { variant: 'secondary', text: 'Email me direct', href: 'mailto:alan@macdougallsystems.com' },
    ]}
    title="Seeing a number you don't like?"
    subtitle="An email nobody opens earns exactly as much as one that never arrived — nothing. Both are fixable."
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Field notes from two decades of email infrastructure: authentication explained, deliverability debugged, and the occasional hard-won lesson committed to writing."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<script>
  // Rough placeholder pre-fill figures — replace with sourced benchmarks
  // before promoting this beyond draft. Values are % .
  const INDUSTRY_PREFILL: Record<string, { open: number; click: number; conversion: number }> = {
    retail: { open: 20, click: 2.5, conversion: 2.2 },
    saas: { open: 23, click: 2.7, conversion: 3.0 },
    agency: { open: 25, click: 3.5, conversion: 5.0 },
    nonprofit: { open: 26, click: 2.5, conversion: 1.5 },
    other: { open: 22, click: 2.5, conversion: 2.0 },
  };

  // Placeholder "achievable open rate" figures — what a strong performer
  // in each industry might sustain. Replace with sourced numbers in the
  // review pass. Values are % .
  const ACHIEVABLE_OPEN: Record<string, number> = {
    retail: 28,
    saas: 30,
    agency: 35,
    nonprofit: 34,
    other: 29,
  };

  const DEFAULT_INBOX_LOSS = 15;

  const gbp = new Intl.NumberFormat('en-GB', {
    style: 'currency',
    currency: 'GBP',
    maximumFractionDigits: 0,
  });

  const fields = {
    industry: document.getElementById('industry') as HTMLSelectElement,
    listSize: document.getElementById('list-size') as HTM
