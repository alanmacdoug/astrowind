---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
// import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const breadcrumbs = [
  { text: 'Home', href: getPermalink('/') },
  ...(currentPage > 1
    ? [{ text: 'Blog', href: getBlogPermalink() }, { text: `Page ${currentPage}` }]
    : [{ text: 'Blog' }]),
];

// const allCategories = await findCategories();
// const allTags = await findTags();

const metadata = {
  title: `Blog${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  description:
    'Email infrastructure and deliverability: authentication, spam-folder diagnosis, sending platforms and twenty years of hard-won lessons.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Breadcrumbs bar items={breadcrumbs} />
  <!-- White background section (hero equivalent) -->
  <section class="bg-white dark:bg-slate-900 px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle="Practical email deliverability writing from twenty years behind the inbox">
      The Blog
    </Headline>
  </section>
  <!-- Slate-100 background section for content -->
  <section class="bg-slate-100 dark:bg-slate-800 px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
  <!-- White background section for CTA -->
  <CallToAction
    actions={[
     {
        variant: 'primary',
        text: 'Free consultation',
        href: '/contact',
      },
    ]}
    title="Email that earns its place in the inbox."
    subtitle="Practical writing on authentication, deliverability and the systems behind both — from twenty years of fixing the same problems."
  />
</Layout>
