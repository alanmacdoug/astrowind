---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'MacDougall Systems — Email Infrastructure & Deliverability',
  description:
    'Twenty years of email infrastructure expertise. SPF, DKIM and DMARC audits, managed email systems, and deliverability diagnostics.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <!-- Hero -->

  <Hero
    id="hero"
    tagline="Email Infrastructure & Deliverability"
    title="Email that earns its place in the inbox."
    actions={[
      { variant: 'primary', text: 'Free Consultation', href: getPermalink('/contact') },
      { variant: 'secondary', text: 'Learn More', href: getPermalink('/services') },
    ]}
  >
    <Fragment slot="subtitle">
      <p>
Since 2006, I've designed, authenticated and repaired email systems. Authentication, sending reputation, marketing automation or overall strategy - if it affects whether your email delivers or earns its keep, it's my speciality.      </p>
    </Fragment>
  </Hero>

  <!-- Free tools showcase (slate-100 — replaces the About section, which now lives on the About page) -->

  <section id="free-tools" class="relative py-12 sm:py-16">
    <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>

    <div class="relative px-4 sm:px-6 mx-auto lg:px-8 max-w-6xl">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl">
          Self help email diagnostic tools
        </h2>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
          A selection of tools to help you understand exactly where improvements can be made. Check
          where you stand with free, browser-based diagnostics. No signup, nothing sent or stored.
        </p>
      </div>

           <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a
          href="/tools/auth-checker"
          class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
        >
          <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Email authentication checker</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
            Check any domain's SPF, DKIM and DMARC — records shown, interpreted in plain English.
          </p>
        </a>
        <a
          href="/tools/dmarc-report-viewer"
          class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
        >
          <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">DMARC report viewer</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
            Upload the aggregate report your inbox provider sends you — get plain English back on who's sending as you.
          </p>
        </a>
        <a
          href="/tools/preflight-checklist"
          class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
        >
          <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Preflight checklist</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
            Ten checks to run before every campaign send — verified in minutes, before your sender reputation pays.
          </p>
        </a>
        <a
          href="/tools/roi-calculator"
          class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
        >
          <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Deliverability ROI calculator</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
            What is better email performance worth to you? Honest numbers out, every assumption shown.
          </p>
        </a>
      </div>    
</div>
  </section>

    <!-- Services -->

  <Features3
    id="services"
    title="What I do"
    subtitle="Bespoke services you can rely on."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Email authentication',
        description: 'SPF, DKIM and DMARC set up, audited and enforced properly — the baseline major inbox providers now demand.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Deliverability rescue',
        description: "Your email is going to spam and you don't know why. I can diagnose the issue and fix it.",
        icon: 'tabler:mail-forward',
      },
      {
        title: 'Managed Mautic hosting',
        description: 'Self-hosted marketing automation, either build only or fully managed service.',
        icon: 'tabler:server',
      },
      {
        title: 'Email strategy consulting',
        description: 'Setup, migrations, automation architecture and list strategy for the platform you already pay for.',
        icon: 'tabler:settings-cog',
      },
      {
        title: 'Sending infrastructure',
        description: 'Relay setup, IP reputation management and segmented sending — newsletters, drip campaigns and transactional mail that perform.',
        icon: 'tabler:route',
      },
      {
        title: 'Full-stack email systems',
        description: 'Where email meets everything else: SMS and messaging integrations, CRM connections, campaign landing pages.',
        icon: 'tabler:plug-connected',
      },
    ]}
  />

   <!-- Process: how engagements run -->

  <Steps
    id="process"
    title="How I SERVE every client"
    subtitle="A defined process, agreed before anything changes — the same discipline for a one-off audit or for ongoing services."
    items={[
      {
        title: 'Survey <span class="font-normal">— consultation & investigation</span>',
        description: `We start with a conversation, then a technical survey of your current setup: DNS, authentication records, sending platforms, list hygiene. No proposals before diagnosis.`,
        icon: 'tabler:search',
      },
      {
        title: 'Explain <span class="font-normal">— findings in plain English</span>',
        description: `You receive a clear picture of what's wrong, what it's costing you, and what fixing it involves. Scope and price are agreed before any changes are made.`,
        icon: 'tabler:message-report',
      },
      {
        title: 'Remediate <span class="font-normal">— implementation</span>',
        description: `The agreed work, done properly: authentication records aligned, systems configured, deliverability repaired. Changes documented as they're made.`,
        icon: 'tabler:tools',
      },
      {
        title: 'Verify <span class="font-normal">— proof it works</span>',
        description: `Tests and reports demonstrating the result — authenticated mail, passing checks, measurable improvement. You see the evidence, not just my word.`,
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Engage <span class="font-normal">— ongoing relationship</span>',
        description: `Where it makes sense: monitoring, maintenance and defined response windows, so problems are caught before your sender reputation pays for them.`,
        icon: 'tabler:users',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Steps>

  <!-- Call to action -->

  <CallToAction
    title="Not sure what you need? Start here"
    subtitle="Book your free consultation with me, or use the diagnostic tools to help understand what is wrong with your email process."
    actions={[
      { variant: 'primary', text: 'Book a Free Consultation', href: getPermalink('/contact') },
      { variant: 'secondary', text: 'Explore Free Tools', href: getPermalink('/tools') },
    ]}
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
