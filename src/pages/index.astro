---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'MacDougall Systems — Email Infrastructure & Deliverability',
  description:
    'Twenty years of email infrastructure expertise. SPF, DKIM and DMARC audits, managed email systems, and deliverability rescue — keeping your email out of the spam folder.',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <!-- Hero -->

  <Hero
    id="hero"
    tagline="Email Infrastructure & Deliverability"
    title="Email that reaches the inbox. Every time."
    actions={[
      {
        variant: 'primary',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/UPWORK_URL',
        target: '_blank',
      },
      { variant: 'secondary', text: 'Get in touch', href: 'mailto:alan@macdougallsystems.com' },
    ]}
  >
    <Fragment slot="subtitle">
      <p>
        Since 2006, I've built, authenticated and repaired email systems for clients across eight countries. SPF, DKIM, DMARC, sending reputation, marketing automation — if it affects whether your email lands, it's my trade.
      </p>
    </Fragment>
  </Hero>

  <!-- About -->

  <Content id="about" columns={2} items={[
      {
        icon: 'tabler:mail',
        callToAction: {
          target: '_blank',
          text: 'Email me',
          href: 'mailto:alan@macdougallsystems.com',
        },
      },
      {
        icon: 'tabler:brand-upwork',
        callToAction: {
          target: '_blank',
          text: 'Upwork profile',
          href: 'https://www.upwork.com/freelancers/UPWORK_URL',
        },
      },
    ]}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Two decades in the pipes</h2>
      <p>
        Email deliverability became a trade before most businesses knew it existed. I've spent my working life in the
        infrastructure behind the inbox: DNS and authentication records, sending reputation, self-hosted marketing
        systems, and the automation platforms that depend on all of it working.
      </p>
      <br />
      <p>
        Between 2006 and my recent years of military service, I built and ran a managed hosting and consultancy business
        serving clients in eight countries — servers, Mautic installations, authentication, SMS and messaging
        integrations. That business closed because I was called away, not because it failed. It's now reopened under
        one name with sharper tools.
      </p>
      <br />
      <p>
        Today the inbox providers have made proper email authentication mandatory for everyone — and most businesses
        haven't caught up. That gap is what MacDougall Systems exists to close.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Process: how engagements run -->

  <Steps
    id="process"
    title="How I work with every client"
    subtitle="A defined process, agreed before anything changes — the same discipline for a one-off audit or an ongoing retainer."
    items={[
      {
        title: 'Survey <span class="font-normal">— consultation & investigation</span>',
        description: `We start with a conversation, then a technical survey of your current setup: DNS, authentication records, sending platforms, list hygiene. No proposals before diagnosis.`,
        icon: 'tabler:search',
      },
      {
        title: 'Explain <span class="font-normal">— findings in plain English</span>',
        description: `You receive a clear picture of what's wrong, what it's costing you, and what fixing it involves. Scope and price are agreed before any changes are made.`,
        icon: 'tabler:message-report',
      },
      {
        title: 'Remediate <span class="font-normal">— implementation</span>',
        description: `The agreed work, done properly: authentication records aligned, systems configured, deliverability repaired. Changes documented as they're made.`,
        icon: 'tabler:tools',
      },
      {
        title: 'Verify <span class="font-normal">— proof it works</span>',
        description: `Tests and reports demonstrating the result — authenticated mail, passing checks, measurable improvement. You see the evidence, not just my word.`,
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Engage <span class="font-normal">— ongoing relationship</span>',
        description: `Where it makes sense: monitoring, maintenance and defined response windows, so problems are caught before your sender reputation pays for them.`,
        icon: 'tabler:users',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Services -->

  <Features3
    id="services"
    title="What I do"
    subtitle="The problems MacDougall Systems solves."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Email authentication',
        description: 'SPF, DKIM and DMARC set up, audited and enforced properly — the baseline the big inbox providers now demand.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Deliverability rescue',
        description: "Your email is going to spam and nobody can tell you why. I can, and I'll fix it.",
        icon: 'tabler:mail-forward',
      },
      {
        title: 'Managed Mautic hosting',
        description: 'Self-hosted marketing automation, run by someone who has administered it in production for years.',
        icon: 'tabler:server',
      },
      {
        title: 'ActiveCampaign consulting',
        description: 'Setup, migrations, automation architecture and list strategy for the platform you already pay for.',
        icon: 'tabler:settings-cog',
      },
      {
        title: 'Sending infrastructure',
        description: 'Relay setup, IP reputation management and segmented sending — newsletters, drip campaigns and transactional mail that behaves.',
        icon: 'tabler:route',
      },
      {
        title: 'Full-stack email systems',
        description: 'Where email meets everything else: SMS and messaging integrations, CRM connections, campaign landing pages.',
        icon: 'tabler:plug-connected',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Features3>

  <!-- Call to action -->

  <CallToAction
    title="Stop guessing where your email lands"
    subtitle="A conversation costs nothing, and a deliverability problem costs you quietly every single day."
    actions={[
      {
        variant: 'primary',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/UPWORK_URL',
        target: '_blank',
      },
      { variant: 'secondary', text: 'Email me direct', href: 'mailto:alan@macdougallsystems.com' },
    ]}
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Field notes from two decades of email infrastructure: authentication explained, deliverability debugged, and the occasional hard-won lesson committed to writing."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
