---
import Layout from '~/layouts/PageLayout.astro';

import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'Book a Consultation',
  description:
    'Book a free consultation about your email deliverability. Tell me what is happening and what your domain is — the first conversation costs nothing.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

  <Hero
    tagline="Consultation"
    title="Book your free consultation"
    subtitle="No charge, no obligation. Tell me what is happening with your email and which domain it concerns — I will look at what I can before we speak, so the conversation starts with substance."
    compact={true}
  />

  <!-- The booking form (slate-100) -->

  <section id="consultation" class="relative bg-slate-100 dark:bg-transparent">
    <div class="px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
      <div
        class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 sm:p-8"
      >
        <form id="consultation-form" class="space-y-6" method="POST" action="/api/contact">
          <!-- Honeypot: Worker checks the "website" field; humans never see it -->

          <div class="hidden" aria-hidden="true">
            <label for="company-website">Company website</label>
            <input
              id="company-website"
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">Your name</span>
              <input
                type="text"
                name="name"
                required
                autocomplete="name"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              />
            </label>

            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">Email address</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              />
            </label>
          </div>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">The domain we will be talking about</span>
            <input
              type="text"
              name="domain"
              placeholder="example.com"
              autocomplete="off"
              spellcheck="false"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <span class="block text-xs text-slate-500 dark:text-slate-400 mt-1.5">
              Optional but strongly recommended. I can look at public DNS before we speak.
            </span>
          </label>

          <div>
            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">What is happening?</span>
              <textarea
                name="message"
                rows="6"
                required
                placeholder="A paragraph or two. Email going to spam, bounces climbing after a migration, planning a new platform, invoices not arriving, unsure of which service you need — whatever the situation, I can help."
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              ></textarea>
            </label>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">
              The more specific the description, the more useful the first conversation.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">What sends email for you today?</span>
              <select
                name="sending-setup"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              >
                <option value="">Select the closest fit…</option>
                <option value="single-esp">One platform (Mailchimp, Klaviyo, etc.)</option>
                <option value="multiple-esp">Several platforms</option>
                <option value="self-hosted">Self-hosted (Mautic, Postal, own server)</option>
                <option value="mixed">Mix of platforms and self-hosted</option>
                <option value="unsure">Not sure / still deciding</option>
              </select>
            </label>

            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">Approximate monthly send volume</span>
              <select
                name="volume"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              >
                <option value="">Select the closest fit…</option>
                <option value="under-1k">Under 1,000</option>
                <option value="1k-10k">1,000 – 10,000</option>
                <option value="10k-50k">10,000 – 50,000</option>
                <option value="50k-plus">50,000+</option>
              </select>
            </label>
          </div>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Anything you want looked at specifically?</span>
            <input
              type="text"
              name="focus"
              placeholder="e.g. DMARC reports, a bounce spike, a migration we are planning"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>

          <button
            type="submit"
            id="submit-btn"
            class="btn btn-primary font-medium rounded-lg px-6 py-3 w-full sm:w-auto"
          >
            Book Consultation
          </button>

          <div id="form-status" class="hidden rounded-lg border p-4 text-sm"></div>
        </form>

        <p class="relative text-center text-xs text-slate-600 dark:text-slate-400 mt-4">
          One reply within one working day to arrange a time.
        </p>
      </div>
    </div>
  </section>

  <!-- What happens next -->

  <section class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold dark:text-white">What happens after you submit</h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
        
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4">
      <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
        <h3 class="font-bold text-lg dark:text-white">1. I check your domain before we speak</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          If you provide the domain, I check the public-facing posture first — SPF, DKIM, DMARC, MX. Thirty minutes on the call then starts with findings rather than questions.
        </p>
      </div>
      <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
        <h3 class="font-bold text-lg dark:text-white">2. The conversation is about diagnosis</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          What is broken, why it is probably broken, and roughly what fixing it involves. If it is a two-hour self-fix, that gets said.
        </p>
      </div>
      <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
        <h3 class="font-bold text-lg dark:text-white">3. You decide what happens next</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          If the problem needs more than a conversation - or you would like to discuss ongoing services - I will prepare a fixed price quote for you to review. There is no obligation to take it, and no drip campaign either way.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Check Your Domain First', href: '/tools/auth-checker' },
    ]}
    title="Want to go in prepared?"
    subtitle="Run the authentication checker on your domain before the call - it is the same first step I'll take too."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </CallToAction>

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<script>
  // Posts JSON to /api/contact (KV + email notification); JavaScript required.

  function init() {
    const form = document.getElementById('consultation-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('form-status');
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (!form || !statusEl || !btn) return;
    if (form.dataset.initDone === 'true') return;
    form.dataset.initDone = 'true';

    function setStatus(kind: 'ok' | 'error', text: string) {
      statusEl.classList.remove('hidden');
      statusEl.className =
        kind === 'ok'
          ? 'rounded-lg border border-emerald-200 dark:border-emerald-700 bg-emerald-50 dark:bg-emerald-900/20 p-4 text-sm text-emerald-800 dark:text-emerald-300'
          : 'rounded-lg border border-red-200 dark:border-red-700 bg-red-50 dark:bg-red-900/20 p-4 text-sm text-red-800 dark:text-red-300';
      statusEl.textContent = text;
    }

    // Returns the human-readable label of a select's chosen option,
    // or '' when nothing is selected.
    function selectedLabel(fieldName: string): string {
      const el = form.elements.namedItem(fieldName);
      if (el instanceof HTMLSelectElement && el.selectedIndex > 0) {
        return el.options[el.selectedIndex].textContent?.trim() || '';
      }
      return '';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const fd = new FormData(form);

      // Honeypot: Worker discards filled values server-side; we short-
      // circuit here too so the bot sees success and no request fires.
      if (String(fd.get('website') || '') !== '') {
        setStatus('ok', 'Thank you. Your booking request has been received.');
        return;
      }

      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      let message = String(fd.get('message') || '').trim();

      // Fold booking details into the message body — the Worker's
      // contract is name/email/message, and this keeps the extras
      // visible in both the KV record and the notification email.
      const details: string[] = [];
      const domain = String(fd.get('domain') || '').trim();
      if (domain) details.push(`Domain: ${domain}`);
      const setup = selectedLabel('sending-setup');
      if (setup) details.push(`Sending setup: ${setup}`);
      const volume = selectedLabel('volume');
      if (volume) details.push(`Approximate volume: ${volume}`);
      const focus = String(fd.get('focus') || '').trim();
      if (focus) details.push(`Specific focus: ${focus}`);
      details.push('Source: consultation booking page');
      message += '\n\n--- Booking details ---\n' + details.join('\n');

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Sending…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name, email, message }),
        });

        if (res.ok) {
          setStatus(
            'ok',
            'Received. I will reply within one working day to arrange a time. If you provided a domain, I will have looked at its public DNS before we speak.',
          );
          form.reset();
        } else {
          // Map the Worker's error codes to plain English.
          let reason = '';
          try {
            const j = await res.json();
            if (j && j.error === 'name') reason = 'the name field looks wrong';
            else if (j && j.error === 'email') reason = 'that email address does not look valid';
            else if (j && j.error === 'message')
              reason = 'the description is missing or too long (5,000 characters maximum)';
            else if (j && j.error === 'invalid_json') reason = 'the form data could not be read';
          } catch {
            /* non-JSON error body */
          }
          setStatus(
            'error',
            'The form could not be sent' +
              (reason ? ' — ' + reason : '') +
              '. Please check the fields and try again, or use the general contact page.',
          );
        }
      } catch {
        setStatus(
          'error',
          'The request could not be sent. Check your connection and try again, or use the general contact page.',
        );
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });
  }

  const pageInit = (window as any).pageInit as ((fn: () => void) => void) | undefined;
  if (typeof pageInit === 'function') {
    pageInit(init);
  } else {
    init();
    document.addEventListener('astro:page-load', init);
  }
</script>
