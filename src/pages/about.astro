---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About',
  description:
    'Alan MacDougall — twenty years in email infrastructure. The story behind MacDougall Systems: the business, the military interlude, and the reopening.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

<Hero
    tagline="About"
    title="One consultant. Twenty years. No middlemen."
    actions={[
      {
        variant: 'primary',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/UPWORK_URL',
        target: '_blank',
      },
      { variant: 'secondary', text: 'Get in touch', href: 'mailto:alan@macdougallsystems.com' },
    ]}
  >
    <Fragment slot="subtitle">
      MacDougall Systems is Alan MacDougall: an email infrastructure consultant who has spent his
      working life in the plumbing behind the inbox — and is now back at it full-time.
    </Fragment>
  </Hero>

  <!-- The story -->

  <Content id="story" isReversed items={[
      {
        title: 'Direct, always',
        description: 'You work with the person doing the work. No account managers, no juniors, no handoffs.',
        icon: 'tabler:users',
      },
      {
        title: 'Evidence over assurances',
        description: 'Recommendations backed by tests, reports and measurements — never "trust me".',
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Scope agreed up front',
        description: 'What will be done, what it costs, and when it will be finished — agreed before anything changes.',
        icon: 'tabler:message-report',
      },
      {
        title: 'Remote, worldwide',
        description: 'Based in Scotland, working with clients wherever they are. Has been the case since 2006.',
        icon: 'tabler:globe',
      },
    ]}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">The story so far</h2>
      <p>
        I started in email marketing in 2006, when deliverability was a craft nobody had named yet. Over the
        following years that grew into a managed hosting and consulting business — servers, email authentication,
        marketing automation, messaging integrations — with clients across eight countries.
      </p>
      <br />
      <p>
        In [YEAR], I closed that business to serve full-time in the military. The closure had nothing to do
        with the clients or the work, and the reviews from that period show it: the business ended because I did,
        not because it failed. After several years of service, including operational deployments, I returned to
        civilian life at the end of 2025.
      </p>
      <br />
      <p>
        MacDougall Systems is the reopening — same discipline, same trade, modern tools. The email world has
        changed in the meantime: the major inbox providers now enforce the authentication standards I've been
        implementing since the beginning. Most businesses haven't caught up. That's where I come in.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- How I work -->

  <Steps2
    title="How I work with every client"
    subtitle="Whether it's a one-off audit or an ongoing retainer, the same five stages: Survey, Explain, Remediate, Verify, Engage."
    items={[
      {
        title: 'Survey',
        description:
          'A conversation, then a technical investigation of your current setup. Diagnosis before proposals, always.',
        icon: 'tabler:search',
      },
      {
        title: 'Explain',
        description:
          'Findings in plain English, with scope and price agreed before any changes are made. You will never wonder what you are paying for.',
        icon: 'tabler:message-report',
      },
      {
        title: 'Remediate & Verify',
        description:
          'The agreed work, implemented and documented — then proven with tests and reports you can see for yourself.',
        icon: 'tabler:tools',
      },
      {
        title: 'Engage',
        description:
          'Where it makes sense, an ongoing relationship with defined response windows, so problems are caught before they cost you.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- What's here now -->

  <Features2
    title="Where everything lives"
    tagline="The working setup"
    columns={3}
    items={[
      {
        title: 'Upwork',
        description: 'Project work is booked through my Upwork profile, where the full work history and reviews live.',
        icon: 'tabler:brand-upwork',
      },
      {
        title: 'This site',
        description: 'The blog carries the working knowledge: authentication, deliverability, and the systems behind both.',
        icon: 'tabler:article',
      },
      {
        title: 'Direct engagement',
        description: 'Retainers and managed services are arranged directly — email is the door.',
        icon: 'tabler:mail',
      },
    ]}
  />

  <!-- CTA -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/UPWORK_URL',
      },
      { variant: 'secondary', text: 'Email me direct', href: 'mailto:alan@macdougallsystems.com' },
    ]}
    title="Let's talk about where your email is landing"
    subtitle="Free conversation. Honest assessment. No obligation."
  />
</Layout>
