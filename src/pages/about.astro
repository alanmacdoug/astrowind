---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';
import Steps from '~/components/widgets/Steps.astro';

import { getPermalink } from '~/utils/permalinks';

import aboutStory from '~/assets/images/about-story.jpg';

const metadata = {
  title: 'About',
  description:
    'Alan MacDougall — twenty years in email infrastructure. The story behind MacDougall Systems: the business, the military interlude, and the reopening.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

<Hero
    tagline="About"
    title="Twenty years in email. From the wild west to AI."
    actions={[
      {
        variant: 'primary',
        text: 'Free consultation',
        href: getPermalink('/contact'),
      },
      { variant: 'secondary', text: 'Free tools', href: getPermalink('/tools') },
    ]}
  >
    <Fragment slot="subtitle">
      MacDougall Systems is Alan MacDougall: an email infrastructure consultant who has spent his
      working life in email — and is now back at it full-time.
    </Fragment>
  </Hero>

  <!-- The story -->

  <Content
    id="story"
    isReversed
    image={{
      src: aboutStory,
      alt: 'A solitary workspace at dusk: a laptop on a worn desk by a window in fading blue light',
      aspect: 'auto',
    }}
    items={[
      {
        title: 'Direct, always',
        description: 'You work with the person doing the work. No account managers, no juniors, no handoffs.',
        icon: 'tabler:users',
      },
      {
        title: 'Evidence over assurances',
        description: 'Recommendations backed by tests, reports and measurements — never "trust me".',
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Scope agreed up front',
        description: 'What will be done, what it costs, and when it will be finished — agreed before anything changes.',
        icon: 'tabler:message-report',
      },
      {
        title: 'Remote, worldwide',
        description: 'Based in Scotland, working with clients wherever they are. Has been the case since 2006.',
        icon: 'tabler:globe',
      },
    ]}
  >
        <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">The story so far</h2>
      <p>
        I started in email marketing in 2006, when deliverability was a craft nobody had named yet. Over the
        following years that grew into a managed hosting and consulting business — servers, email authentication,
        marketing automation, messaging integrations — serving clients across the UK, Europe and beyond.
      </p>
      <br />
      <p>
        MacDougall Systems is the continuation of that work: same discipline, same trade, modern tools. The email
        world has changed in the meantime: the major inbox providers now enforce the authentication standards I've
        been implementing since the beginning. Most businesses haven't caught up. That's where I come in.
      </p>
      <br />
      <p>
        Twenty years in, the fundamentals are unchanged: authenticated mail reaches the inbox, unauthenticated
        mail doesn't. The difference now is that the enforcement mechanisms are automatic and unforgiving. Clients
        don't want to become experts in DNS and sender reputation — they want their email to work. That's what I do.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- How I work -->

  <Steps
    id="process"
    title="How I work with every client"
    subtitle="A defined process, agreed before anything changes — the same discipline for a one-off audit or for ongoing services."
    items={[
      {
        title: 'Survey <span class="font-normal">— consultation & investigation</span>',
        description: `We start with a conversation, then a technical survey of your current setup: DNS, authentication records, sending platforms, list hygiene. No proposals before diagnosis.`,
        icon: 'tabler:search',
      },
      {
        title: 'Explain <span class="font-normal">— findings in plain English</span>',
        description: `You receive a clear picture of what's wrong, what it's costing you, and what fixing it involves. Scope and price are agreed before any changes are made.`,
        icon: 'tabler:message-report',
      },
      {
        title: 'Remediate <span class="font-normal">— implementation</span>',
        description: `The agreed work, done properly: authentication records aligned, systems configured, deliverability repaired. Changes documented as they're made.`,
        icon: 'tabler:tools',
      },
      {
        title: 'Verify <span class="font-normal">— proof it works</span>',
        description: `Tests and reports demonstrating the result — authenticated mail, passing checks, measurable improvement. You see the evidence, not just my word.`,
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Engage <span class="font-normal">— ongoing relationship</span>',
        description: `Where it makes sense: monitoring, maintenance and defined response windows, so problems are caught before your sender reputation pays for them.`,
        icon: 'tabler:users',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Steps>

  <!-- What's here now -->

  <Features2
    title="Where everything lives"
    tagline="The working setup"
    columns={3}
    items={[
      {
        title: 'This site',
        description: 'The blog carries the working knowledge: authentication, deliverability, and the systems behind both.',
        icon: 'tabler:article',
      },
      {
        title: 'Free tools',
        description: "Check your own domain's authentication records, and cost out platforms before committing to one.",
        icon: 'tabler:tool',
      },
      {
        title: 'Direct engagement',
        description: 'Consultations, retainers and managed services are arranged directly — email is the door.',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- CTA -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a free consultation',
        href: getPermalink('/contact'),
      },
      { variant: 'secondary', text: 'Explore free tools', href: getPermalink('/tools') },
    ]}
    title="Let's talk about where your email is landing"
    subtitle="Free conversation. Honest assessment. No obligation."
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and commentary on authentication, deliverability and overall strategy — the questions clients ask, answered in the blog."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
