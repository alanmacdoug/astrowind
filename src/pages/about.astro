---
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import Steps from '~/components/widgets/Steps.astro';

import { getPermalink } from '~/utils/permalinks';

import aboutStory from '~/assets/images/about-story.jpg';

const metadata = {
  title: 'About',
  description:
    'Twenty years in email infrastructure. One consultant serving clients worldwide — authentication, deliverability and marketing automation.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

<Hero
    tagline="About"
    title="Twenty years in email. From the wild west to AI."
    actions={[
      {
        variant: 'primary',
        text: 'Free Consultation',
        href: getPermalink('/contact'),
      },
      { variant: 'secondary', text: 'Free Tools', href: getPermalink('/tools') },
    ]}
  >
    <Fragment slot="subtitle">
      Email infrastructure and deliverability consultancy. Based in Scotland, working with clients worldwide.

    </Fragment>
  </Hero>

  <!-- The story -->

  <Content
    id="story"
    isReversed
    image={{
      src: aboutStory,
      alt: 'A solitary workspace at dusk: a laptop on a worn desk by a window in fading blue light',
      aspect: 'auto',
    }}
    items={[
      {
        title: 'Direct, always',
        description: 'You work with the person doing the work. No account managers, no outsourcing',
        icon: 'tabler:users',
      },
      {
        title: 'Evidence over assurances',
        description: 'Recommendations backed by tests, reports and measurements — never "trust me".',
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Scope agreed up front',
        description: 'What will be done, what it costs, and when it will be finished — agreed before anything changes.',
        icon: 'tabler:message-report',
      },
      {
        title: 'Remote, worldwide',
        description: 'Based in Scotland, working with clients wherever they are.',
        icon: 'tabler:globe',
      },
    ]}
  >
        <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About MacDougall Systems</h2>
      <p>
        I started in email marketing in 2006, when in comparison to more recent times, delivery was still the wild west. Over the
        following years I built a managed hosting and consulting business, adapting to rapidly changing technological and legal landscapes. The pace of that change has never been faster, with AI reshaping how email campaigns are sent and received. 
</p>
      <br />
      <p>
I've worked with clients in the UK, Europe, the US and beyond, specialising in delivery systems, email authentication,
        marketing automation and strategy. MacDougall Systems is the continuation of that work: same discipline, same specialities, modern tools.
      </p>
      <br />
      <p>
        Twenty years in, the fundamentals are unchanged: authenticated mail reaches the inbox, unauthenticated
        mail doesn't. Well-managed campaigns convert; poorly managed ones don't. The difference now is that the
        enforcement mechanisms are unforgiving, and it's hard for businesses to keep up to date with the latest best practices — that's where I come in: keeping your systems current while you run your business.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Content>

   <!-- How I SERVE every client -->

  <Steps
    id="process"
    title="How I SERVE every client"
    subtitle="A defined process, agreed before anything changes — the same discipline for a one-off audit or for ongoing services."
    items={[
      {
        title: 'Survey <span class="font-normal">— consultation & investigation</span>',
        description: `We start with a conversation, then a technical survey of your current setup: DNS, authentication records, sending platforms, list hygiene. No proposals before diagnosis.`,
        icon: 'tabler:search',
      },
      {
        title: 'Explain <span class="font-normal">— findings in plain English</span>',
        description: `You receive a clear picture of what's wrong, what it's costing you, and what fixing it involves. Scope and price are agreed before any changes are made.`,
        icon: 'tabler:message-report',
      },
      {
        title: 'Remediate <span class="font-normal">— implementation</span>',
        description: `The agreed work, done properly: authentication records aligned, systems configured, deliverability repaired. Changes documented as they're made.`,
        icon: 'tabler:tools',
      },
      {
        title: 'Verify <span class="font-normal">— proof it works</span>',
        description: `Tests and reports demonstrating the result — authenticated mail, passing checks, measurable improvement. You see the evidence, not just my word.`,
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Engage <span class="font-normal">— ongoing relationship</span>',
        description: `Where it makes sense: monitoring, maintenance and defined response windows, so problems are caught before your sender reputation pays for them.`,
        icon: 'tabler:users',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-slate-900"></div>
    </Fragment>
  </Steps>

  <!-- What's here now -->

  <Features2
    title="3 types of help"
    tagline="Using this site"
    columns={3}
    items={[
      {
        title: 'The blog',
        description: 'The blog carries the working knowledge: authentication, deliverability, and the systems behind both.',
        icon: 'tabler:article',
      },
      {
        title: 'Free tools',
        description: "Check your own domain's authentication records, and cost out platforms before committing to one.",
        icon: 'tabler:tool',
      },
      {
        title: 'Services',
        description: 'Consultations, retainers and managed services are arranged directly — contact to discuss further.',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- CTA -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Free Consultation',
        href: getPermalink('/contact'),
      },
      { variant: 'secondary', text: 'Explore Free Tools', href: getPermalink('/tools') },
    ]}
    title="Let's discuss how I can help improve your email processes"
    subtitle="Free conversation. Honest assessment. No obligation."
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
