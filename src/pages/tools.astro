---
import Layout from '~/layouts/PageLayout.astro';

import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'Tools',
  description:
    'Free client-side email authentication checker. Enter a domain to see its SPF, DKIM and DMARC posture as the major inbox providers see it — with the raw DNS records included.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

  <Hero
    tagline="Tools"
    title="Check your email authentication"
    subtitle="Enter a domain and see its SPF, DKIM and DMARC posture as the major inbox providers see it — including the exact DNS records, interpreted in plain English. No signup, nothing sent, nothing stored."
  />

  <!-- The tool -->

  <section id="auth-checker" class="relative bg-slate-100 dark:bg-transparent">
    <div class="px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
      <div
        class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 sm:p-8"
      >
        <form id="checker-form" class="flex flex-col sm:flex-row gap-3">
          <label for="domain-input" class="sr-only">Domain to check</label>
          <input
            id="domain-input"
            type="text"
            name="domain"
            placeholder="example.com"
            autocomplete="off"
            spellcheck="false"
            class="flex-1 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
          />
          <button
            type="submit"
            id="check-button"
            class="btn btn-primary font-medium rounded-lg px-6 py-3 whitespace-nowrap"
          >
            Check domain
          </button>
        </form>

        <div id="status" class="mt-4 text-slate-500 dark:text-slate-400 text-sm hidden"></div>

        <div id="results" class="mt-6 space-y-4"></div>
      </div>

      <p class="relative text-center text-xs text-slate-500 dark:text-slate-400 mt-4">
        This tool runs entirely in your browser. Nothing is sent, logged or stored — your domain is queried
        directly against public DNS.
      </p>
    </div>
  </section>

  <!-- What these records do -->

  <Features3
    title="What these records do"
    subtitle="Three lines of DNS text decide whether the inbox trusts your mail."
    columns={3}
    items={[
      {
        title: 'SPF',
        description:
          'Lists the servers allowed to send mail for your domain. Too many includes, and the record silently stops being evaluated.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'DKIM',
        description:
          'Cryptographically signs your outgoing mail so receivers can verify it was not tampered with in transit.',
        icon: 'tabler:key',
      },
      {
        title: 'DMARC',
        description:
          'Tells receivers what to do when SPF or DKIM fail — and where to send the reports. Published as p=none is watching, not enforcing.',
        icon: 'tabler:eye-check',
      },
    ]}
  />

  <!-- More tools -->

  <section id="more-tools" class="relative bg-slate-100 dark:bg-transparent">
    <div class="px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold dark:text-white">More tools</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Free, browser-based, nothing to sign up for.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/roi-calculator"
          class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
        >
          <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Deliverability cost calculator</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
            What is poor inbox placement and weak open rates costing you each month? Line-by-line maths, honest
            numbers out.
          </p>
        </a>
        <a
          href="/mautic-cost-comparison"
          class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
        >
          <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Mautic vs ESP cost comparison</h3>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
            Managed Mautic against typical ESP pricing — find the subscriber count where the crossover happens.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/~0151852008049f31c2',
      },
      { variant: 'secondary', text: 'Email me direct', href: 'mailto:alan@macdougallsystems.com' },
    ]}
    title="Seeing problems in the results?"
    subtitle="These issues are exactly what an authentication audit resolves — fixed price from £150."
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Field notes from two decades of email infrastructure: authentication explained, deliverability debugged, and the occasional hard-won lesson committed to writing."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<script>
  // --- DoH client -----------------------------------------------------------

  const DOH_ENDPOINTS = [
    'https://dns.google/resolve',
    'https://cloudflare-dns.com/dns-query',
  ];

  async function dohQuery(name: string, type: string): Promise<any[]> {
    for (const endpoint of DOH_ENDPOINTS) {
      try {
        const url = `${endpoint}?name=${encodeURIComponent(name)}&type=${type}`;
        const res = await fetch(url, { headers: { accept: 'application/dns-json' } });
        if (!res.ok) continue;
        const json: any = await res.json();
        if (json && json.Status === 3) return []; // NXDOMAIN — authoritative, no fallback needed
        if (json && json.Status === 0) return Array.isArray(json.Answer) ? json.Answer : [];
        continue; // any other status: try the next endpoint
      } catch {
        // try next endpoint
      }
    }
    throw new Error('DNS lookup failed for ' + name);
  }

  function txtRecords(answers: any[]): string[] {
    return answers
      .filter((a) => a.type === 16)
      .map((a) => String(a.data).replace(/^"|"$/g, ''));
  }

  // --- Parsers ---------------------------------------------------------------

  function parseSPF(records: string[]) {
    const spfRecords = records.filter((r) => r.toLowerCase().startsWith('v=spf1'));
    if (spfRecords.length === 0)
      return { found: false, count: 0, qualifier: '', terms: [] as string[] };
    const terms = spfRecords[0].split(/\s+/).slice(1);
    const allTerm = terms.find((t) => /^[~+\-?]?all$/i.test(t)) || '';
    const qualifier = allTerm ? allTerm.charAt(0) : '';
    return { found: true, count: spfRecords.length, qualifier, terms };
  }

  type SpfWalkItem = { term: string; cost: number; note?: string };
  type SpfWalk = { lookups: number; items: SpfWalkItem[] };

  // Walks the SPF record and returns the total DNS lookup count plus a
  // per-term breakdown attributed to the top-level mechanism that caused it.
  // Handles both `include:`/`redirect:` (colon) and `redirect=` (equals)
  // modifier forms — a redirect costs one lookup plus its includes' cost.
  async function walkSPF(records: string[], visited: Set<string>, depth = 0): Promise<SpfWalk> {
    const result: SpfWalk = { lookups: 0, items: [] };
    const spf = parseSPF(records);
    if (!spf.found || depth > 10) return result;
    for (const term of spf.terms) {
      const mech = term.split(/[=:]/)[0].toLowerCase();
      if (['include', 'redirect', 'a', 'mx', 'ptr', 'exists'].includes(mech)) {
        let cost = 1;
        let note: string | undefined;
        if ((mech === 'include' || mech === 'redirect') && depth < 6) {
          const sepIdx = term.indexOf(':') !== -1 ? term.indexOf(':') : term.indexOf('=');
          const target = sepIdx !== -1 ? term.slice(sepIdx + 1) : '';
          if (target && !visited.has(target)) {
            visited.add(target);
            try {
              const sub = txtRecords(await dohQuery(target, 'TXT'));
              const subWalk = await walkSPF(sub, visited, depth + 1);
              cost += subWalk.lookups;
              if (subWalk.lookups > 0) {
                note = `includes ${subWalk.lookups} nested lookup${subWalk.lookups === 1 ? '' : 's'}`;
              }
            } catch (e) {
              console.warn('Include lookup failed for', target, e);
              note = 'could not be resolved — counts as its single lookup';
            }
          }
        }
        result.lookups += cost;
        result.items.push({ term, cost, note });
      }
    }
    return result;
  }

  function parseDMARC(records: string[]) {
    const dmarc = records.find((r) => r.toLowerCase().startsWith('v=dmarc1'));
    if (!dmarc)
      return { found: false, policy: '', rua: false, ruaAddress: '', pct: null as number | null, sp: '' };
    const pMatch = dmarc.match(/(?:^|;)\s*p\s*=\s*(\w+)/i);
    const pctMatch = dmarc.match(/(?:^|;)\s*pct\s*=\s*(\d+)/i);
    const spMatch = dmarc.match(/(?:^|;)\s*sp\s*=\s*(\w+)/i);
    const ruaMatch = dmarc.match(/(?:^|;)\s*rua\s*=\s*([^;]+)/i);
    return {
      found: true,
      policy: pMatch ? pMatch[1].toLowerCase() : '',
      rua: !!ruaMatch,
      ruaAddress: ruaMatch ? ruaMatch[1].trim() : '',
      pct: pctMatch ? parseInt(pctMatch[1], 10) : null,
      sp: spMatch ? spMatch[1].toLowerCase() : '',
    };
  }

  const DKIM_SELECTORS = [
    'default',
    'google',
    'selector1',
    'selector2',
    's1',
    's2',
    'k1',
    'k2',
    'mail',
    'smtp',
    'dkim',
    'zoho',
  ];

  // --- Mail provider fingerprinting (MX hostname matching) --------------------

  const MX_PROVIDERS: { name: string; match: RegExp; spfHint: string }[] = [
    { name: 'Google Workspace', match: /google(mail)?\.com|aspmx.*google/i, spfHint: '_spf.google.com' },
    { name: 'Microsoft 365', match: /mail\.protection\.outlook\.com/i, spfHint: 'spf.protection.outlook.com' },
    { name: 'Zoho Mail', match: /zoho/i, spfHint: 'zoho' },
    { name: 'Fastmail', match: /fastmail|messagingengine\.com/i, spfHint: 'messagingengine.com' },
    { name: 'Proton Mail', match: /proton\.me|protonmail\.ch/i, spfHint: '_spf.proton.me' },
    { name: 'iCloud Mail', match: /icloud\.com|apple\.com/i, spfHint: '_spf.trek.icloud.com' },
    { name: 'GoDaddy', match: /secureserver\.net/i, spfHint: 'secureserver.net' },
    { name: 'IONOS / 1&1', match: /perfora\.net|kundenserver\.de|ionos/i, spfHint: 'ionos' },
    { name: 'Proofpoint (gateway)', match: /pphosted|ppops\.net|proofpoint/i, spfHint: 'pphosted.com' },
    { name: 'Mimecast (gateway)', match: /mimecast/i, spfHint: 'mimecast' },
    { name: 'Cisco Secure Email (gateway)', match: /iphmx\.com/i, spfHint: 'iphmx.com' },
    { name: 'Barracuda (gateway)', match: /barracuda/i, spfHint: 'barracuda' },
  ];

  function identifyProvider(mxHosts: string[]): string | null {
    for (const p of MX_PROVIDERS) {
      if (mxHosts.some((h) => p.match.test(h))) return p.name;
    }
    return null;
  }

  // --- Rendering helpers -----------------------------------------------------

  const resultsEl = document.getElementById('results')!;
  const statusEl = document.getElementById('status')!;
  const form = document.getElementById('checker-form') as HTMLFormElement;
  const input = document.getElementById('domain-input') as HTMLInputElement;
  const button = document.getElementById('check-button') as HTMLButtonElement;

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
    );
  }

  function chip(status: 'pass' | 'warn' | 'fail'): string {
    const styles: Record<string, string> = {
      pass: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300',
      warn: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
      fail: 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300',
    };
    const labels: Record<string, string> = { pass: 'OK', warn: 'Check', fail: 'Issue' };
    return `<span class="inline-block text-xs font-semibold uppercase tracking-wide rounded-full px-2.5 py-1 ${styles[status]}">${labels[status]}</span>`;
  }

  function card(title: string, status: 'pass' | 'warn' | 'fail', bodyHtml: string): string {
    return `
      <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-4">
        <div class="flex items-center justify-between gap-3">
          <h3 class="font-bold text-lg dark:text-white">${title}</h3>
          ${chip(status)}
        </div>
        <div class="mt-2 text-sm text-slate-600 dark:text-slate-300 space-y-1">${bodyHtml}</div>
      </div>`;
  }

  function rawBlock(records: string[], label?: string): string {
    if (!records || records.length === 0) return '';
    const n = records.length;
    return `
      <details class="mt-2">
        <summary class="cursor-pointer select-none text-xs font-medium text-primary dark:text-primary-300">View raw record${n > 1 ? 's' : ''}${label ? ' — ' + esc(label) : ''}</summary>
        <pre class="mt-2 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md p-3 overflow-x-auto whitespace-pre-wrap break-all text-slate-700 dark:text-slate-300">${records.map(esc).join('\n\n')}</pre>
      </details>`;
  }

  function detailBlock(summary: string, innerHtml: string): string {
    return `
      <details class="mt-2">
        <summary class="cursor-pointer select-none text-xs font-medium text-primary dark:text-primary-300">${esc(summary)}</summary>
        <div class="mt-2 text-sm text-slate-600 dark:text-slate-300">${innerHtml}</div>
      </details>`;
  }

  function normDomain(raw: string): string | null {
    let d = raw.trim().toLowerCase();
    d = d.replace(/^https?:\/\//, '').replace(/^www\./, '');
    if (d.includes('@')) d = d.split('@').pop() || '';
    d = d.split('/')[0].split(':')[0];
    if (!/^[a-z0-9][a-z0-9.-]*[a-z0-9]$/.test(d) || !d.includes('.')) return null;
    return d;
  }

  // --- Main check -------------------------------------------------------------

  async function runCheck(domain: string) {
    resultsEl.innerHTML = '';
    button.disabled = true;
    button.textContent = 'Checking…';

    try {
      setStatus('Querying DNS records for ' + domain + '…');

      const [txt, dmarcRaw, mx, dkimHits] = await Promise.all([
        dohQuery(domain, 'TXT'),
        dohQuery(`_dmarc.${domain}`, 'TXT'),
        dohQuery(domain, 'MX'),
        (async () => {
          const hits: { selector: string; record: string }[] = [];
          for (const s of DKIM_SELECTORS) {
            try {
              const ans = await dohQuery(`${s}._domainkey.${domain}`, 'TXT');
              const keyTexts = txtRecords(ans).filter(
                (t) => /(^|\s)v=DKIM1/i.test(t) || /(^|;)\s*p=/.test(t),
              );
              if (keyTexts.length > 0) hits.push({ selector: s, record: keyTexts[0] });
            } catch {
              /* selector unresolved — skip */
            }
          }
          return hits;
        })(),
      ]);

      const txts = txtRecords(txt);
      const dmarcRecord = txtRecords(dmarcRaw);
      const dmarc = parseDMARC(dmarcRecord);
      const spf = parseSPF(txts);
      const spfRawRecords = txts.filter((t) => t.toLowerCase().startsWith('v=spf1'));

      const mxRecords = mx
        .filter((a) => a.type === 15)
        .map((a) => String(a.data))
        .sort();
      const mxHosts = mxRecords.map((d) => (d.split(' ').pop() || '').replace(/\.$/, ''));
      const provider = identifyProvider(mxHosts);

      setStatus('Walking SPF includes…');
      const spfWalk: SpfWalk = spf.found
        ? await walkSPF(txts, new Set())
        : { lookups: 0, items: [] };

      renderResults(domain, {
        spfRawRecords,
        spf,
        spfWalk,
        dmarc,
        dmarcRecord,
        mxRecords,
        mxHosts,
        provider,
        dkimHits,
      });
    } catch (err) {
      console.error('Auth check failed:', err);
      resultsEl.innerHTML = card(
        'Lookup failed',
        'fail',
        `<p>The DNS queries could not be completed. Reason: <code>${esc(String(err))}</code>. Try again in a moment.</p>`,
      );
    } finally {
      setStatus('');
      button.disabled = false;
      button.textContent = 'Check domain';
    }
  }

  function setStatus(text: string) {
    if (!text) {
      statusEl.classList.add('hidden');
    } else {
      statusEl.classList.remove('hidden');
      statusEl.textContent = text;
    }
  }

  function renderResults(
    domain: string,
    r: {
      spfRawRecords: string[];
      spf: { found: boolean; count: number; qualifier: string; terms: string[] };
      spfWalk: SpfWalk;
      dmarc: { found: boolean; policy: string; rua: boolean; ruaAddress: string; pct: number | null; sp: string };
      dmarcRecord: string[];
      mxRecords: string[];
      mxHosts: string[];
      provider: string | null;
      dkimHits: { selector: string; record: string }[];
    },
  ) {
    let html = '';
    let issues = 0;

    // SPF — merged card: record verdict, lookup depth, mechanism breakdown
    if (!r.spf.found) {
      issues++;
      html += card(
        'SPF',
        'fail',
        '<p>No SPF record found. Receivers have no list of authorised senders for this domain.</p>',
      );
    } else {
      let body = `<p>Record found with ${r.spf.terms.length} mechanisms.</p>`;
      let status: 'pass' | 'warn' | 'fail' = 'pass';
      if (r.spf.count > 1) {
        issues++;
        status = 'fail';
        body += `<p><strong>${r.spf.count} SPF records found</strong> — multiple records invalidate each other. This must be fixed.</p>`;
      }
      const q = r.spf.qualifier;
      if (q === '-') {
        body += '<p>Enforcing (<code>-all</code>): unauthorised senders are rejected.</p>';
      } else if (q === '~') {
        body += '<p>Softfail (<code>~all</code>): unauthorised senders pass but are marked. Workable, but weaker than <code>-all</code>.</p>';
      } else {
        issues++;
        status = status === 'fail' ? 'fail' : 'warn';
        body += '<p>No <code>-all</code> enforcement at the end of the record — anything not matched may still pass.</p>';
      }

      // Lookup depth (merged from the old separate card)
      const lookups = r.spfWalk.lookups;
      body += `<p>DNS lookups required to evaluate this record: <strong>${lookups}</strong> of 10 allowed. Beyond 10, receivers stop evaluating the record entirely.</p>`;
      if (lookups > 10) {
        issues++;
        status = 'fail';
        body += '<p><strong>Over the limit</strong> — parts of this record are being ignored. Authorised senders may be failing authentication without anyone noticing.</p>';
      } else if (lookups >= 8) {
        issues++;
        status = status === 'fail' ? 'fail' : 'warn';
        body += '<p>Close to the 10-lookup limit. Any new sending service could push it over.</p>';
      }

      // Cross-check: identified provider vs SPF content — informational
      if (r.provider) {
        const p = MX_PROVIDERS.find((pr) => pr.name === r.provider)!;
        if (p.spfHint && !r.spf.terms.some((t) => t.toLowerCase().includes(p.spfHint.toLowerCase()))) {
          body += `<p>Your mail appears to be handled by <strong>${esc(r.provider)}</strong>, but the SPF record does not mention <code>${esc(p.spfHint)}</code>. Mail sent through that platform may be failing SPF for this domain.</p>`;
        }
      }

      // Expandable per-term breakdown with per-include lookup costs
      if (r.spfWalk.items.length > 0) {
        const rows = r.spfWalk.items
          .map((it) => {
            const plural = it.cost === 1 ? '' : 's';
            const note = it.note ? ` — ${esc(it.note)}` : '';
            return `<li><code>${esc(it.term)}</code> — ${it.cost} lookup${plural}${note}</li>`;
          })
          .join('');
        body += detailBlock(
          'Show mechanism breakdown with lookup costs',
          `<ul class="space-y-1 list-disc pl-5">${rows}</ul>`,
        );
      }

      body += rawBlock(r.spfRawRecords, 'SPF record');
      html += card('SPF', status, body);
    }

    // DKIM — informational: absence is not proof of a problem, so it never
    // increments the issues counter
    {
      let body = '';
      if (r.dkimHits.length > 0) {
        body = `<p>Public keys found for ${r.dkimHits.map((h) => esc(h.selector)).join(', ')}.</p>`;
        body += rawBlock(
          r.dkimHits.map((h) => `${h.selector}._domainkey.${domain}\n${h.record}`),
          'DKIM public keys',
        );
        body += '<p class="text-xs">Note: absence of other selectors does not prove DKIM is missing — private or unusual selectors will not appear here.</p>';
      } else {
        body = '<p>No public keys found among common selectors. This domain may use a private selector — or may not sign mail at all.</p>';
        body += '<p class="text-xs">Note: this check probes common selector names only and cannot conclusively rule DKIM in or out.</p>';
      }
      const status: 'pass' | 'warn' = r.dkimHits.length > 0 ? 'pass' : 'warn';
      html += card('DKIM', status, body);
    }

    // DMARC
    if (!r.dmarc.found) {
      issues++;
      html += card('DMARC', 'fail', '<p>No DMARC record found. Receivers apply their own policy to unauthenticated mail from this domain — spoofing goes unchecked.</p>');
    } else {
      const policy = r.dmarc.policy || 'none';
      let body = `<p>Policy: <code>p=${esc(policy)}</code>.</p>`;
      if (policy === 'reject') {
        body += '<p>Full enforcement: unauthenticated mail is rejected.</p>';
      } else if (policy === 'quarantine') {
        body += '<p>Enforced: unauthenticated mail is sent to spam.</p>';
      } else {
        issues++;
        body += '<p>Monitor-only (<code>p=none</code>): reports are generated but no enforcement happens. Spoofed mail still delivers — this is where every domain should start, but it is not a place to stay.</p>';
      }
      if (r.dmarc.sp && r.dmarc.sp !== policy) {
        body += `<p>Subdomain policy: <code>sp=${esc(r.dmarc.sp)}</code> applies to subdomains instead.</p>`;
      }
      if (r.dmarc.pct !== null && r.dmarc.pct < 100) {
        body += `<p>Policy applies to only <code>pct=${r.dmarc.pct}%</code> of messages — enforcement is being phased in gradually.</p>`;
      }
      body += r.dmarc.rua
        ? `<p>Aggregate reports are being collected${r.dmarc.ruaAddress ? ` (<code>${esc(r.dmarc.ruaAddress)}</code>)` : ''} — someone is monitoring this domain.</p>`
        : '<p>No reporting address (<code>rua</code>) — aggregate reports are not being collected, so nobody sees who is spoofing this domain.</p>';
      body += rawBlock(r.dmarcRecord, 'DMARC record');
      const status: 'pass' | 'warn' | 'fail' = policy === 'reject' || policy === 'quarantine' ? 'pass' : 'warn';
      html += card('DMARC', status, body);
    }

    // MX / provider fingerprint — informational
    {
      let body = '';
      if (r.mxHosts.length === 0) {
        body = '<p>No MX records found — this domain does not receive mail. That is fine if intentional.</p>';
      } else if (r.provider) {
        body = `<p>Mail for this domain is handled by <strong>${esc(r.provider)}</strong>.</p>`;
      } else {
        body = '<p>Mail exchangers found, but they do not match a known provider.</p>';
      }
      body += rawBlock(r.mxRecords, 'MX records');
      html += card('Mail provider (MX)', 'pass', body);
    }

    // Verdict + conditional funnel
    if (issues > 0) {
      html += `
        <div class="rounded-lg bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-700 p-4 text-center">
          <p class="font-semibold text-lg dark:text-white">Issues found: ${issues}</p>
          <p class="text-sm text-slate-600 dark:text-slate-300 mt-1">These issues are exactly what an authentication audit resolves — typically within days, at a fixed price.</p>
          <a href="/contact" class="btn btn-primary inline-block mt-3 px-5 py-2.5 rounded-lg font-medium">Get an audit — from £150</a>
        </div>`;
    } else {
      html += `
        <div class="rounded-lg bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-700 p-4 text-center">
          <p class="font-semibold text-lg dark:text-white">All checks pass</p>
          <p class="text-sm text-slate-600 dark:text-slate-300 mt-1">Records like these drift over time. Monitoring catches it before your reputation pays.</p>
        </div>`;
    }

    resultsEl.innerHTML = html;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const domain = normDomain(input.value);
    if (!domain) {
      setStatus('Please enter a valid domain, e.g. example.com');
      return;
    }
    runCheck(domain);
  });
</script>
