---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'The Brief',
  description:
    'The MacDougall Email newsletter: a free weekly brief on email deliverability, plus a Premium tier with deeper monthly reports and Sentry Lite domain monitoring.',
};

// Tier data lives here so pricing/copy edits happen in one place.
// Payment links (Stripe/Gumroad) are TODO — Premium CTA is disabled until launch.
const tiers = [
  {
    name: 'Free Weekly',
    price: '£0',
    cadence: 'forever',
    summary:
      'One email a week. What changed in deliverability, what it means, and one thing worth doing about it.',
    features: [
      'Deliverability, authentication and infrastructure — plain English, no vendor spin',
      'New tools and posts first, before they go public',
      'No spam, no resale, one click to leave',
    ],
    ctaText: 'Join the Brief',
    ctaHref: '#signup-form-wrap',
    highlight: false,
    comingSoon: false,
  },
  {
    name: 'Premium',
    price: '£15',
    cadence: 'per month',
    summary:
      'The weekly brief, plus a monthly deep dive and Sentry Lite — your monthly domain health snapshot.',
    features: [
      'Monthly deep dive: the detail the weekly format cannot carry',
      'Sentry Lite: monthly SPF, DKIM and DMARC validation and report',
      'Green/amber/red status with any configuration changes detected',
      'The free weekly brief as standard',
      'Cancel any time, keep everything you have learned',
    ],
    ctaText: 'Coming Soon',
    ctaHref: '#',
    highlight: true,
    comingSoon: true,
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero (default) -->

  <Hero
    id="hero"
    tagline="The Brief"
    title="Email news and insight you can act on"
    subtitle="A weekly brief on authentication, deliverability and the infrastructure behind it — written by someone who fixes those things for a living."
    actions={[
      { variant: 'primary', text: 'Join the Brief', href: '#signup-form-wrap' },
      { variant: 'secondary', text: 'View Services', href: getPermalink('/services') },
    ]}
  />

  <!-- Tiers (slate-100) -->

  <section id="tiers" class="relative py-12 sm:py-16">
    <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>

    <div class="relative px-4 sm:px-6 mx-auto lg:px-8 max-w-5xl">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold dark:text-white sm:text-3xl">Choose your level</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
          Start free. Upgrade when the detail is worth paying for.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 max-w-3xl mx-auto">
        {tiers.map((tier) => (
          <div
            class={`relative flex flex-col rounded-2xl shadow-lg border p-6 ${
              tier.highlight
                ? 'bg-white dark:bg-slate-900 border-primary opacity-75'
                : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700'
            }`}
          >
            {tier.highlight && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-semibold px-3 py-1 rounded-full">
                Coming Soon
              </span>
            )}
            <h3 class="text-lg font-bold dark:text-white">{tier.name}</h3>
            <p class="mt-3">
              <span class="text-3xl font-extrabold dark:text-white">{tier.price}</span>
              <span class="text-sm text-slate-600 dark:text-slate-300"> {tier.cadence}</span>
            </p>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">{tier.summary}</p>
            <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-300 flex-1">
              {tier.features.map((feature) => (
                <li class="flex gap-2">
                  <span aria-hidden="true">&#10003;</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <a
              href={tier.ctaHref}
              aria-disabled={tier.comingSoon ? 'true' : undefined}
              class={`btn ${tier.highlight ? 'btn-primary' : 'btn-outline'} rounded-lg px-5 py-2.5 font-medium mt-6 text-center ${tier.comingSoon ? 'pointer-events-none' : ''}`}
            >
              {tier.ctaText}
            </a>
          </div>
        ))}
      </div>

      <p class="text-center text-xs text-slate-600 dark:text-slate-400 mt-6">
        Prices in GBP. Premium launches shortly. Need direct advice instead? <a href="/services-pricing" class="underline">Wingman advisory is a service tier</a>.
      </p>
    </div>
  </section>

  <!-- Signup form: hidden until a Join the Brief button is clicked,
       then expanded in place directly under the tier boxes (default bg) -->

  <section id="signup-form-wrap" class="hidden">
    <div class="px-4 sm:px-6 mx-auto lg:px-8 max-w-xl py-12 sm:py-16">
      <form id="subscribe-form" novalidate>
        <label for="subscribe-email" class="block text-sm font-medium dark:text-white sr-only">
          Email address
        </label>
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            id="subscribe-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="flex-1 w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-4 py-2.5 text-slate-900 dark:text-white placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
          />
          <!-- Honeypot: hidden from humans and screen readers -->
          <div aria-hidden="true" class="hidden">
            <label for="subscribe-website">Leave this field empty</label>
            <input
              id="subscribe-website"
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <button
            type="submit"
            class="btn btn-primary rounded-lg px-5 py-2.5 font-medium text-center"
          >
            Join the Brief
          </button>
        </div>
        <p
          id="subscribe-status"
          role="status"
          aria-live="polite"
          class="mt-3 text-sm text-center text-slate-600 dark:text-slate-300"
        ></p>
      </form>
    </div>
  </section>

  <!-- What to expect (slate-100) -->

  <section id="what-to-expect" class="relative py-12 sm:py-16">
    <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>

    <div class="relative px-4 sm:px-6 mx-auto lg:px-8 max-w-3xl">
      <h2 class="text-2xl font-bold dark:text-white sm:text-3xl text-center">Who is writing this</h2>
      <div class="mt-8 space-y-6 text-slate-600 dark:text-slate-300">
        <p>
          Me. I run email infrastructure and deliverability work daily — the newsletter is where the
          practical end of that work gets written down. No ghostwriters, no recycled press releases,
          no vendor talking points.
        </p>
        <p>
          Every issue connects to something you can act on: a free tool, a configuration change, a
          check worth running. If it does not earn its place in your inbox, unsubscribe — one click,
          no questions.
        </p>
      </div>
    </div>
  </section>

  <!-- Blog (default, last before footer) -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  />
</Layout>

<script>
  // Signup reveal + form submit. Any "Join the Brief" CTA (hero button or
  // free-tier card) expands the hidden form under the tier boxes and
  // focuses the email field, then scrolls it into view.
  function initSubscribeForm() {
    const wrap = document.getElementById('signup-form-wrap');
    if (!wrap || wrap.dataset.initialized) return;
    wrap.dataset.initialized = 'true';

    // Intercept every CTA pointing at the form container.
    document.querySelectorAll('a[href="#signup-form-wrap"]').forEach((cta) => {
      cta.addEventListener('click', (event) => {
        event.preventDefault();
        wrap.classList.remove('hidden');
        wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
        document.getElementById('subscribe-email')?.focus();
      });
    });

    const form = document.getElementById('subscribe-form');
    const statusEl = document.getElementById('subscribe-status');
    const button = form?.querySelector('button[type="submit"]');
    if (!form) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const emailInput = document.getElementById('subscribe-email');
      const email = emailInput ? emailInput.value.trim() : '';
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (statusEl) statusEl.textContent = 'Please enter a valid email address.';
        return;
      }

      const honeypot = form.querySelector('input[name="website"]');
      const payload = {
        email,
        website: honeypot ? honeypot.value : '',
        source: 'brief',
      };

      if (button) button.disabled = true;
      if (statusEl) statusEl.textContent = 'Adding you…';

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json().catch(() => ({ ok: false }));

        if (response.ok && data.ok) {
          if (statusEl) statusEl.textContent = 'You are on the list. Watch your inbox for the first Brief.';
          form.reset();
        } else {
          if (statusEl) statusEl.textContent = 'That did not go through. Check the address and try again.';
          if (button) button.disabled = false;
        }
      } catch (err) {
        if (statusEl) statusEl.textContent = 'Something went wrong on the network. Try again in a moment.';
        if (button) button.disabled = false;
      }
    });
  }

  document.addEventListener('astro:page-load', initSubscribeForm);
  initSubscribeForm();
</script>       
