---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'The Brief',
  description:
    'The MacDougall Email newsletter: a free weekly brief on email deliverability, plus a Premium tier with deeper monthly reports and a monthly domain health check.',
};

// Tier data lives here so pricing/copy edits happen in one place.
// Payment links (Stripe/Gumroad) are TODO — Premium CTA is disabled until launch.
// Wingman tier moved to services-pricing — advisory service, not newsletter content.
const tiers = [
  {
    name: 'Free Weekly',
    price: '£0',
    cadence: 'forever',
    summary:
      'One brief every week: what changed in deliverability, what it means, and one thing worth doing about it.',
    features: [
      'Weekly email covering authentication, deliverability and infrastructure in plain English',
      'First access to new tools and posts',
      'No spam, no resale of your address. Unsubscribe any time',
    ],
    ctaText: 'Sign Up Free',
    ctaHref: '#signup',
    highlight: false,
    comingSoon: false,
  },
  {
    name: 'Premium',
    price: '£15',
    cadence: 'per month',
    summary:
      'Everything in the free brief, plus detailed monthly reporting and analysis on top.',
    features: [
      'Detailed monthly report: deeper analysis and insight than the weekly brief carries',
      'Monthly domain health check: SPF, DKIM and DMARC validation report',
      'The free weekly brief as standard',
      'Cancel any time, keep what you have learned',
    ],
    ctaText: 'Coming Soon',
    ctaHref: '#',
    highlight: true,
    comingSoon: true,
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero (default) -->

  <Hero
    id="hero"
    tagline="The Brief"
    title="Email deliverability, without the noise"
    subtitle="A weekly brief on what is actually happening to your email: authentication, deliverability and the infrastructure behind it. Written by someone who runs it for a living."
    actions={[
      { variant: 'primary', text: 'Sign Up Free', href: '#signup' },
      { variant: 'secondary', text: 'View Services', href: getPermalink('/services') },
    ]}
  />

  <!-- Tiers (slate-100) -->

  <section id="tiers" class="relative py-12 sm:py-16">
    <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>

    <div class="relative px-4 sm:px-6 mx-auto lg:px-8 max-w-5xl">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold dark:text-white sm:text-3xl">Choose your level</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
          Start free. Upgrade when the detail is worth it to you.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 max-w-3xl mx-auto">
        {tiers.map((tier) => (
          <div
            class={`relative flex flex-col rounded-2xl shadow-lg border p-6 ${
              tier.highlight
                ? 'bg-white dark:bg-slate-900 border-primary opacity-75'
                : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700'
            }`}
          >
            {tier.highlight && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-semibold px-3 py-1 rounded-full">
                Coming Soon
              </span>
            )}
            <h3 class="text-lg font-bold dark:text-white">{tier.name}</h3>
            <p class="mt-3">
              <span class="text-3xl font-extrabold dark:text-white">{tier.price}</span>
              <span class="text-sm text-slate-600 dark:text-slate-300"> {tier.cadence}</span>
            </p>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">{tier.summary}</p>
            <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-300 flex-1">
              {tier.features.map((feature) => (
                <li class="flex gap-2">
                  <span aria-hidden="true">&#10003;</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <a
              href={tier.ctaHref}
              aria-disabled={tier.comingSoon ? 'true' : undefined}
              class={`btn ${tier.highlight ? 'btn-primary' : 'btn-outline'} rounded-lg px-5 py-2.5 font-medium mt-6 text-center ${tier.comingSoon ? 'pointer-events-none' : ''}`}
            >
              {tier.ctaText}
            </a>
          </div>
        ))}
      </div>

      <p class="text-center text-xs text-slate-600 dark:text-slate-400 mt-6">
        Prices in GBP. Premium launches shortly. Need direct advice instead? <a href="/services-pricing" class="underline">Wingman advisory is a service tier</a>.
      </p>
    </div>
  </section>

  <!-- Email signup (default) -->

  <section id="signup" class="relative py-12 sm:py-16">
    <div class="px-4 sm:px-6 mx-auto lg:px-8 max-w-xl">
      <h2 class="text-2xl font-bold dark:text-white sm:text-3xl text-center">
        Get the free weekly brief
      </h2>
      <p class="mt-3 text-center text-sm text-slate-600 dark:text-slate-300">
        One email a week. Plain English, no noise, unsubscribe any time.
      </p>

      <form id="subscribe-form" class="mt-8" novalidate>
        <label for="subscribe-email" class="block text-sm font-medium dark:text-white sr-only">
          Email address
        </label>
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            id="subscribe-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="flex-1 w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-4 py-2.5 text-slate-900 dark:text-white placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
          />
          <!-- Honeypot: hidden from humans and screen readers -->
          <div aria-hidden="true" class="hidden">
            <label for="subscribe-website">Leave this field empty</label>
            <input
              id="subscribe-website"
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <button
            type="submit"
            class="btn btn-primary rounded-lg px-5 py-2.5 font-medium text-center"
          >
            Sign Up Free
          </button>
        </div>
        <p
          id="subscribe-status"
          role="status"
          aria-live="polite"
          class="mt-3 text-sm text-center text-slate-600 dark:text-slate-300"
        ></p>
      </form>
    </div>
  </section>

  <!-- What to expect (slate-100) -->

  <section id="what-to-expect" class="relative py-12 sm:py-16">
    <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>

    <div class="relative px-4 sm:px-6 mx-auto lg:px-8 max-w-3xl">
      <h2 class="text-2xl font-bold dark:text-white sm:text-3xl text-center">What every tier gets</h2>
      <div class="mt-8 space-y-6 text-slate-600 dark:text-slate-300">
        <p>
          The Brief is written by me. I run email infrastructure and deliverability work daily, and
          the newsletter is where the practical end of that work gets written down. No ghostwriters,
          no recycled press releases.
        </p>
        <p>
          Every issue connects to something you can act on: a free tool, a configuration change, a
          check worth running. Premium subscribers get the same work in more depth, with detailed
          monthly reports and analysis on their own domain's health.
        </p>
      </div>
    </div>
  </section>

  <!-- Call to action (default) -->

  <CallToAction
    title="Start with the free weekly brief"
    subtitle="One email a week. Useful or unsubscribe, no hard feelings either way."
    actions={[
      { variant: 'primary', text: 'Sign Up Free', href: '#signup' },
    ]}
  />

  <!-- Blog (slate-100, last before footer) -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<script>
  // Subscribe form — POSTs to /api/subscribe (Cloudflare Worker).
  // Init is idempotent and listens for astro:page-load so the form
  // survives View Transitions soft navigation without needing a
  // hard refresh (the lesson from the DMARC parser race conditions).
  function initSubscribeForm() {
    const form = document.getElementById('subscribe-form');
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    const statusEl = document.getElementById('subscribe-status');
    const button = form.querySelector('button[type="submit"]');
    const originalButtonText = button ? button.textContent : '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const emailInput = document.getElementById('subscribe-email');
      const email = emailInput ? emailInput.value.trim() : '';
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        statusEl.textContent = 'Please enter a valid email address.';
        return;
      }

      const honeypot = form.querySelector('input[name="website"]');
      const payload = {
        email,
        website: honeypot ? honeypot.value : '',
        source: 'brief',
      };

      button.disabled = true;
      statusEl.textContent = 'Signing you up\u2026';

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json().catch(() => ({ ok: false }));

        if (response.ok && data.ok) {
          statusEl.textContent = 'You are on the list. Watch your inbox for the first Brief.';
          form.reset();
        } else {
          statusEl.textContent = 'That did not go through. Check the address and try again.';
          button.disabled = false;
        }
      } catch (err) {
        statusEl.textContent = 'Something went wrong on the network. Try again in a moment.';
        button.disabled = false;
      }
    });
  }

  document.addEventListener('astro:page-load', initSubscribeForm);
  initSubscribeForm();
</script>
