---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'SPF Record Generator — Build Your SPF Deliberately',
  description:
    'Build an SPF record from scratch, sender by sender. See the lookup budget in real time as you add each include.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Tools"
    title="Build your SPF record step by step"
    subtitle="Answer a few questions about what sends email for your domain. See the lookup count in real time as you add each include."
    compact={true}
  />

  <!-- Entire tool: counter, interview, policy, output -->
  <section class="bg-slate-100 py-8 md:py-12 dark:bg-slate-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-8 text-center">
        <p class="text-muted">
          Every sender confirmed here adds an entry to your SPF record. Watch the lookup budget climb as you go —
          the ten-lookup limit is where SPF breaks entirely.
        </p>
      </div>

      <!-- Live lookup counter (sticky — count and budget warnings only) -->
      <div id="counter-display" class="sticky top-4 z-50 mb-4 p-4 rounded-lg border shadow-lg bg-white dark:bg-slate-900 dark:border-slate-700">
        <h3 class="text-lg font-bold">Current SPF budget used: <span id="lookup-count">0</span>/10 lookups</h3>
        <div id="limit-warning" class="hidden mt-3 p-3 bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400 rounded text-sm">
          Warning: You're approaching the lookup limit. Each platform may use additional lookups internally.
        </div>
        <div id="limit-exceeded" class="hidden mt-3 p-3 bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 rounded text-sm">
          Alert: You've exceeded the SPF lookup limit (10). This record will fail evaluation.
        </div>
      </div>

      <!-- Sender breakdown (static — sits below the sticky count) -->
      <div class="mb-8 p-6 rounded-lg border bg-white dark:bg-slate-900 dark:border-slate-700">
        <h4 class="text-sm font-bold mb-3 uppercase tracking-wide text-slate-500 dark:text-slate-400">Senders added</h4>
        <ul id="lookup-breakdown" class="space-y-2 text-sm">
          <li class="text-muted italic">No senders added yet</li>
        </ul>
      </div>

      <!-- Interview section -->
      <div id="interview-section" class="space-y-6 mb-8">

        <!-- Question 1: Google Workspace -->
        <div id="question-google" class="p-6 rounded-lg border bg-white dark:bg-slate-900 dark:border-slate-700">
          <p class="text-base font-medium mb-4">Does Google Workspace send email as your domain?</p>
          <div class="flex gap-4">
            <button id="btn-google-yes" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded">Yes</button>
            <button id="btn-google-no" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 rounded">No</button>
          </div>
        </div>

        <!-- Question 2: Microsoft 365 -->
        <div id="question-m365" class="p-6 rounded-lg border bg-white dark:bg-slate-900 dark:border-slate-700">
          <p class="text-base font-medium mb-4">Does Microsoft 365 send email as your domain?</p>
          <div class="flex gap-4">
            <button id="btn-m365-yes" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded">Yes</button>
            <button id="btn-m365-no" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 rounded">No</button>
          </div>
        </div>

        <!-- Question 3: Marketing platform -->
        <div id="question-marketing" class="p-6 rounded-lg border bg-white dark:bg-slate-900 dark:border-slate-700">
          <p class="text-base font-medium mb-4">Does a marketing platform send email as your domain?</p>
          <div id="marketing-dropdown" class="mb-4 hidden">
            <select id="marketing-platform" class="w-full p-2 border rounded dark:bg-slate-800 dark:border-slate-700">
              <option value="">Select a platform...</option>
              <option value="sendgrid|include:sendgrid.net|2">SendGrid</option>
              <option value="mailchimp|include:servers.mcsv.net|1">Mailchimp</option>
              <option value="activecampaign|include:emails.activecampaign.com|2">ActiveCampaign</option>
              <option value="custom-ip|ip4|0">Custom SMTP (enter below)</option>
            </select>
          </div>
          <div class="flex gap-4">
            <button id="btn-marketing-yes" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded">Yes</button>
            <button id="btn-marketing-no" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 rounded">No</button>
          </div>
        </div>

        <!-- Question 4: Custom IP ranges -->
        <div id="question-custom" class="p-6 rounded-lg border bg-white dark:bg-slate-900 dark:border-slate-700">
          <p class="text-base font-medium mb-4">Do you have custom servers sending as your domain?</p>
          <input id="custom-ip" type="text" placeholder="Enter IP range (e.g., 192.0.2.0/24)" class="mb-2 w-full p-2 border rounded dark:bg-slate-800 dark:border-slate-700" />
          <p id="custom-ip-error" class="hidden mb-2 text-sm text-red-600 dark:text-red-400">
            That doesn't look like a valid IP address or range. Expected format: 192.0.2.10 or 192.0.2.0/24.
          </p>
          <button id="btn-custom-confirm" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded disabled:bg-slate-400" disabled>Confirm Custom IP</button>
        </div>

        <!-- Question 5: Other services — add your own entries -->
        <div id="question-other" class="p-6 rounded-lg border bg-white dark:bg-slate-900 dark:border-slate-700">
          <p class="text-base font-medium mb-2">Any other services sending as your domain?</p>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">
            Most businesses have a few. Enter the hostname exactly as your provider's documentation gives it —
            for example <code>_spf.example.com</code> — or a full entry like <code>include:example.com</code>,
            <code>ip4:203.0.113.10</code> or <code>ip6:2001:db8::/32</code>. Hostnames are treated as includes
            and cost one lookup each; IP entries are free.
          </p>
          <input id="custom-mechanism" type="text" placeholder="_spf.example.com" class="mb-2 w-full p-2 border rounded dark:bg-slate-800 dark:border-slate-700" />
          <p id="custom-mechanism-error" class="hidden mb-2 text-sm text-red-600 dark:text-red-400">
            Enter a hostname (e.g. _spf.example.com) or an entry starting with include:, ip4: or ip6:.
          </p>
          <button id="btn-custom-mechanism" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded disabled:bg-slate-400" disabled>Add Entry</button>
          <p class="mt-4 text-sm text-muted italic">
            Not sure what a sender needs? An audit finds your active sending streams and maps them to your record —
            <a href="/contact" class="link font-medium">Book a Free Consultation.</a>
          </p>
        </div>
      </div>

      <!-- Policy choice -->
      <div id="policy-section" class="mb-8 p-6 rounded-lg border bg-white dark:bg-slate-900 dark:border-slate-700">
        <h3 class="text-lg font-bold mb-4">What closing mechanism should your record use?</h3>
        <div class="space-y-3">
          <label class="flex items-start gap-3">
            <input type="radio" name="policy" value="~all" checked class="mt-1" />
            <span>
              <strong>~all (soft fail)</strong> — Recommended while testing. Unmatched mail is flagged but not rejected.
            </span>
          </label>
          <label class="flex items-start gap-3">
            <input type="radio" name="policy" value="-all" class="mt-1" />
            <span>
              <strong>-all (hard fail)</strong> — Only use when you're certain nothing legitimate is unaccounted for.
            </span>
          </label>
        </div>
        <button id="btn-generate" class="mt-4 px-6 py-3 bg-primary hover:bg-primary-dark text-white rounded font-bold">Generate SPF Record</button>
      </div>

      <!-- Output section -->
      <div id="output-section" class="hidden mb-8 p-6 rounded-lg border bg-white dark:bg-slate-900 dark:border-slate-700">
        <h3 class="text-lg font-bold mb-4">Your SPF Record</h3>
        <div class="bg-slate-100 dark:bg-slate-800 p-4 rounded mb-4 font-mono text-sm break-all">
          <span id="spf-record-output">v=spf1 ...</span>
        </div>
        <div class="flex items-center mb-4">
          <button id="btn-copy" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 rounded">Copy to Clipboard</button>
          <span id="copy-status" class="ml-3 text-sm text-green-600 dark:text-green-400" role="status"></span>
        </div>
        <div class="border-t pt-4 dark:border-slate-700">
          <h4 class="font-bold mb-2">What each entry means:</h4>
          <ul id="record-explanation" class="space-y-2 text-sm text-muted"></ul>
        </div>
      </div>
    </div>
  </section>

  <!-- About this tool -->
  <section id="about-this-tool" class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold dark:text-white">Why the lookup count is built in</h2>
    </div>
    <div class="space-y-4 text-slate-600 dark:text-slate-300">
      <p>
        SPF has a hard limit of ten DNS lookups per evaluation. Every <code>include:</code> entry costs at least one
        lookup, and some platforms use several internally once their own record is fetched. A record that crosses
        the limit stops being evaluated partway through, and mail can fail SPF for reasons that look baffling from
        the outside: nothing in the record is wrong, but the budget is spent before the end is reached.
      </p>
      <p>
        That is why this generator counts as you build. Each sender you add appears in the budget immediately,
        so you see the cost of your record take shape before it goes anywhere near DNS. IP entries are shown as
        free because they are: <code>ip4:</code> and <code>ip6:</code> mechanisms are read straight from the record
        with no further fetching, which makes them a reliable way to authorise known servers without spending budget.
      </p>
      <p>
        A record that stays comfortably inside the budget keeps a reserve for the day you add one more platform, or
        your provider changes what their include points at. If the count creeps toward ten, that is the signal to
        consolidate sends behind fewer, larger includes rather than authorise one more small service.
      </p>
            <p>
        Once your record is live, the <a href="/tools/auth-checker" class="link font-medium">email authentication checker</a> confirms what the world sees when it fetches it, and the <a href="/dmarc-report-reading-checklist" class="link font-medium">DMARC report reading checklist</a> covers what mailbox providers actually did with the mail that claimed to be you. Both are free. If you would rather hand the whole picture to someone who does this daily, the <a href="/consultation" class="link font-medium">audit</a> maps your live sending streams and builds the record for you.
      </p>
    </div>
  </section>

  <!-- CTA -->

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Book Your Free Consultation', href: '/consultation' }
    ]}
    title="Senders you can't identify?"
    subtitle="Most records miss something — a helpdesk, a billing system, an app nobody remembers installing. An audit checks your live sending streams against your SPF record. From £149, no further obligation."
  />

  <!-- More tools (white — alternates against the tool's slate-100) -->

  <section id="more-tools" class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold dark:text-white">More tools</h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
        Free, browser-based, nothing to sign up for.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href="/tools/auth-checker"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Email authentication checker</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Check any domain's SPF, DKIM and DMARC — records shown, interpreted in plain English.
        </p>
      </a>
      <a
        href="/tools/dmarc-report-viewer"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">DMARC report viewer</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Upload the aggregate report your inbox provider sends you — get plain English back on who's sending as you.
        </p>
      </a>
      <a
        href="/tools/preflight-checklist"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Preflight checklist</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Ten checks to run before every campaign send — verified in minutes, before your sender reputation pays.
        </p>
      </a>
      <a
        href="/tools/roi-calculator"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Deliverability ROI calculator</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          What is better email performance worth to you? Honest numbers out, every assumption shown.
        </p>
      </a>
      <a
        href="/tools/mautic-cost-comparison"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Mautic vs ESP cost comparison</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Managed Mautic against typical ESP pricing — find the subscriber count where the crossover happens.
        </p>
      </a>
    </div>
  </section>

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<script>
  // --- SPF Record Generator ----------------------------------------------
  // Interactive state lives in init() so soft navigation binds fresh
  // listeners against the swapped DOM; the guard prevents duplicates.

  // --- State ------------------------------------------------------------------

  let senderData: Map<string, { entry: string; cost: number }>;
  let customEntryCount: number;

  // Escape untrusted strings before inserting into innerHTML
  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function hideQuestion(id: string) {
    const el = document.getElementById(id);
    if (el) el.classList.add('hidden');
  }

  function addSender(key: string, entry: string, cost: number) {
    if (senderData.has(key)) return;
    senderData.set(key, { entry, cost });
    updateCounter();
  }

  function updateCounter() {
    let totalLookups = 0;
    let breakdownHTML = '';

    senderData.forEach(({ entry, cost }, key) => {
      totalLookups += cost;
      breakdownHTML += `<li><code>${escapeHtml(entry)}</code> — ${cost} lookup${cost !== 1 ? 's' : ''} (${cost === 0 ? 'free' : 'budget'})</li>`;
    });

    if (senderData.size === 0) {
      breakdownHTML = '<li class="text-muted italic">No senders added yet</li>';
    }

    const countEl = document.getElementById('lookup-count');
    const breakdownEl = document.getElementById('lookup-breakdown');
    if (countEl) countEl.textContent = String(totalLookups);
    if (breakdownEl) breakdownEl.innerHTML = breakdownHTML;

    const warning = document.getElementById('limit-warning');
    const exceeded = document.getElementById('limit-exceeded');

    if (totalLookups >= 8 && totalLookups < 10) {
      warning?.classList.remove('hidden');
      exceeded?.classList.add('hidden');
    } else if (totalLookups >= 10) {
      warning?.classList.add('hidden');
      exceeded?.classList.remove('hidden');
    } else {
      warning?.classList.add('hidden');
      exceeded?.classList.add('hidden');
    }
  }

  // --- Validation helpers ---------------------------------------------------

  const IPV4_RE = /^(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}(\/(\d|[12]\d|3[0-2]))?$/;

  // Hostnames commonly start with an underscore in SPF includes
  // (e.g. _spf.example.com), so underscores are valid in labels.
  const HOSTNAME_RE = /^([a-z0-9_-]+\.)+[a-z]{2,}$/i;

  // Accepts include:/ip4:/ip6: entries and bare hostnames; a bare
  // hostname is normalised to an include: entry. Returns null if invalid.
  function normalizeMechanism(v: string): string | null {
    if (v.startsWith('include:')) {
      return HOSTNAME_RE.test(v.slice(8)) ? v : null;
    }
    if (v.startsWith('ip4:')) {
      return IPV4_RE.test(v.slice(4)) ? v : null;
    }
    if (v.startsWith('ip6:')) {
      return /^ip6:[0-9a-fA-F:.]+(\/\d{1,3})?$/.test(v) ? v : null;
    }
    if (HOSTNAME_RE.test(v)) {
      return `include:${v}`;
    }
    return null;
  }

  function mechanismCost(v: string): number {
    return v.startsWith('include:') ? 1 : 0;
  }

  function addMarketingPlatform(value: string) {
    if (!value || senderData.has('marketing')) return;

    const [name, entry, costStr] = value.split('|');
    const cost = parseInt(costStr, 10);

    if (name === 'custom-ip') {
      // Route the user to the custom IP question instead of dead-ending
      hideQuestion('question-marketing');
      const q = document.getElementById('question-custom');
      if (q) {
        q.scrollIntoView({ behavior: 'smooth', block: 'center' });
        q.classList.add('ring-2', 'ring-primary', 'rounded-lg');
        setTimeout(() => q.classList.remove('ring-2', 'ring-primary'), 2500);
      }
      return;
    }

    senderData.set('marketing', { entry, cost });
    updateCounter();
    hideQuestion('question-marketing');
  }

  function generateRecord() {
    const policyEls = document.querySelectorAll<HTMLInputElement>('input[name="policy"]:checked');
    const policyEl = policyEls[0];
    const policy = policyEl ? policyEl.value : '~all';
    const spfParts = ['v=spf1'];

    senderData.forEach(({ entry }) => {
      spfParts.push(entry);
    });

    spfParts.push(policy);

    const outputEl = document.getElementById('spf-record-output');
    if (outputEl) outputEl.textContent = spfParts.join(' ');

    const outputSection = document.getElementById('output-section');
    if (outputSection) outputSection.classList.remove('hidden');

    const explanation = document.getElementById('record-explanation');
    if (explanation) {
      explanation.innerHTML = '';
      senderData.forEach(({ entry }, key) => {
        let meaning = '';
        switch (key) {
          case 'google':
            meaning = 'authorises Google Workspace sending servers';
            break;
          case 'm365':
            meaning = 'authorises Microsoft 365 sending servers';
            break;
          case 'marketing':
            meaning = 'authorises your chosen marketing platform';
            break;
          case 'custom-ip-added':
            meaning = 'authorises your custom server at this range (no lookup cost)';
            break;
          default:
            meaning = entry.startsWith('include:')
              ? 'authorises the additional sending service you entered (one lookup)'
              : 'authorises the sending range you entered (no lookup cost)';
        }
        explanation.innerHTML += `<li><code>${escapeHtml(entry)}</code> — ${meaning}</li>`;
      });
    }
  }

  function copyToClipboard() {
    const textEl = document.getElementById('spf-record-output');
    const status = document.getElementById('copy-status');
    if (!textEl || !status) return;
    const text = textEl.textContent || '';
    navigator.clipboard.writeText(text).then(() => {
      status.textContent = 'Copied to clipboard.';
      setTimeout(() => { status.textContent = ''; }, 3000);
    }).catch(() => {
      status.textContent = 'Copy failed — select the record above and copy manually.';
      setTimeout(() => { status.textContent = ''; }, 4000);
    });
  }

  // --- Event bindings ---------------------------------------------------------

  function init() {
    const guardEl = document.getElementById('btn-generate');
    if (!guardEl || guardEl.dataset.initDone === 'true') return;
    guardEl.dataset.initDone = 'true';

    // Reset state for fresh page session
    senderData = new Map();
    customEntryCount = 0;

    // Google Workspace
    const btnGoogleYes = document.getElementById('btn-google-yes');
    const btnGoogleNo = document.getElementById('btn-google-no');
    if (btnGoogleYes) {
      btnGoogleYes.addEventListener('click', () => {
        addSender('google', 'include:_spf.google.com', 1);
        hideQuestion('question-google');
      });
    }
    if (btnGoogleNo) {
      btnGoogleNo.addEventListener('click', () => hideQuestion('question-google'));
    }

    // Microsoft 365
    const btnM365Yes = document.getElementById('btn-m365-yes');
    const btnM365No = document.getElementById('btn-m365-no');
    if (btnM365Yes) {
      btnM365Yes.addEventListener('click', () => {
        addSender('m365', 'include:spf.protection.outlook.com', 1);
        hideQuestion('question-m365');
      });
    }
    if (btnM365No) {
      btnM365No.addEventListener('click', () => hideQuestion('question-m365'));
    }

    // Marketing platform
    const btnMarketingYes = document.getElementById('btn-marketing-yes');
    const btnMarketingNo = document.getElementById('btn-marketing-no');
    const marketingDropdown = document.getElementById('marketing-dropdown');
    const marketingPlatform = document.getElementById('marketing-platform') as HTMLSelectElement | null;

    if (btnMarketingYes) {
      btnMarketingYes.addEventListener('click', () => {
        if (marketingDropdown) marketingDropdown.classList.remove('hidden');
      });
    }
    if (btnMarketingNo) {
      btnMarketingNo.addEventListener('click', () => hideQuestion('question-marketing'));
    }
    if (marketingPlatform) {
      marketingPlatform.addEventListener('change', (e) => {
        addMarketingPlatform((e.target as HTMLSelectElement).value);
      });
    }

    // Custom IP validation
    const customInput = document.getElementById('custom-ip') as HTMLInputElement | null;
    const customBtn = document.getElementById('btn-custom-confirm') as HTMLButtonElement | null;
    const customError = document.getElementById('custom-ip-error');

    if (customInput && customBtn) {
      customInput.addEventListener('input', () => {
        const v = customInput.value.trim();
        if (v === '') {
          customBtn.disabled = true;
          customError?.classList.add('hidden');
          return;
        }
        const valid = IPV4_RE.test(v);
        customBtn.disabled = !valid;
        customError?.classList.toggle('hidden', valid);
      });
      customBtn.addEventListener('click', () => {
        const ip = customInput.value.trim();
        if (!ip || !IPV4_RE.test(ip)) return;
        addSender('custom-ip-added', `ip4:${ip}`, 0);
        hideQuestion('question-custom');
      });
    }

    // Custom mechanism (repeatable entries, shorthand-friendly)
    const mechInput = document.getElementById('custom-mechanism') as HTMLInputElement | null;
    const mechBtn = document.getElementById('btn-custom-mechanism') as HTMLButtonElement | null;
    const mechError = document.getElementById('custom-mechanism-error');

    if (mechInput && mechBtn) {
      mechInput.addEventListener('input', () => {
        const v = mechInput.value.trim();
        if (v === '') {
          mechBtn.disabled = true;
          mechError?.classList.add('hidden');
          return;
        }
        const valid = normalizeMechanism(v) !== null;
        mechBtn.disabled = !valid;
        mechError?.classList.toggle('hidden', valid);
      });
      mechBtn.addEventListener('click', () => {
        const raw = mechInput.value.trim();
        const normalized = raw ? normalizeMechanism(raw) : null;
        if (!normalized) return;
        customEntryCount++;
        addSender(`custom-entry-${customEntryCount}`, normalized, mechanismCost(normalized));
        mechInput.value = '';
        mechBtn.disabled = true;
        mechInput.focus();
      });
    }

    // Generate and Copy
    if (guardEl) {
      guardEl.addEventListener('click', generateRecord);
    }

    const btnCopy = document.getElementById('btn-copy');
    if (btnCopy) {
      btnCopy.addEventListener('click', copyToClipboard);
    }

    // Initial counter display
    updateCounter();
  }

  const pageInit = (window as any).pageInit as ((fn: () => void) => void) | undefined;
  if (typeof pageInit === 'function') {
    pageInit(init);
  } else {
    // Fallback if the layout helper is ever absent: bind directly and
    // listen for astro:page-load ourselves (same guard makes this safe).
    init();
    document.addEventListener('astro:page-load', init);
  }
</script>
