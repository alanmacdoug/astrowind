---
import Layout from '~/layouts/PageLayout.astro';

import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'ROI Calculator',
  description:
    'Model what your email programme earns today — and what improving open rates, click rates or conversions is worth to your business each month.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

 <Hero
    tagline="Tools"
    title="What is better email performance worth to you?"
    subtitle="Enter your numbers and see what your email programme earns today — then test what improving each rate would be worth. Your numbers in, honest maths out."
compact={true}
  />

  <!-- The calculator (slate-100) -->

  <section id="roi-calculator" class="relative bg-slate-100 dark:bg-transparent">
    <div class="px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
      <div
        class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 sm:p-8"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">List size (subscribers)</span>
            <input
              id="list-size"
              type="number"
              min="1"
              value="5000"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Emails per subscriber per month</span>
            <input
              id="send-frequency"
              type="number"
              min="0.5"
              step="0.5"
              value="4"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>

          <div>
            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">Open rate (%)</span>
              <input
                id="open-rate"
                type="number"
                min="0"
                max="100"
                step="0.1"
                value="28"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              />
            </label>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">
              Platform-reported open rates are inflated by Apple Mail Privacy Protection — use your reported figure
              and treat it as approximate.
            </p>
          </div>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Click rate (% of opens)</span>
            <input
              id="click-rate"
              type="number"
              min="0"
              max="100"
              step="0.1"
              value="6.8"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Conversion rate (% of clicks)</span>
            <input
              id="conversion-rate"
              type="number"
              min="0"
              max="100"
              step="0.1"
              value="5"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Customer value (£)</span>
            <input
              id="customer-value"
              type="number"
              min="1"
              value="60"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>

          <div>
            <label class="block">
              <span class="block text-sm font-medium dark:text-white mb-1">Bounce rate (%)</span>
              <input
                id="bounce-rate"
                type="number"
                min="0"
                max="100"
                step="0.1"
                value="2"
                class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
              />
            </label>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">
              Bounced mail never arrives. This is kept to a minimum with good list hygiene — and a sustained high
              bounce rate drags sender reputation, and everything above it, down with it.
            </p>
          </div>
        </div>

        <button
          type="button"
          id="calc-button"
          class="btn btn-primary font-medium rounded-lg px-6 py-3 mt-6 w-full sm:w-auto"
        >
          Calculate
        </button>

        <div id="results" class="mt-8"></div>
      </div>

      <p class="relative text-center text-xs text-slate-600 dark:text-slate-400 mt-4">
        Runs entirely in your browser — nothing is sent or stored. Default figures are generic starting points,
        not benchmarks: replace them with your own numbers from your email platform's dashboard.
      </p>
    </div>
  </section>
  <!-- About this tool -->
  <section id="about-this-tool" class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold dark:text-white">Why every stage of the maths is shown</h2>
    </div>
    <div class="space-y-4 text-slate-600 dark:text-slate-300">
      <p>
        A single headline number — "your email programme earns £X a month" — tells you nothing about where it
        comes from or what would move it. So the result here is built in front of you, stage by stage: sends,
        deliveries, opens, clicks, conversions, revenue, each line carrying the assumption that produced it.
        If you disagree with any stage, you know exactly which input to change, and what the change is worth.
      </p>
      <p>
        The improvement section works the same way. Each rate — open, click, conversion — is tested alone,
        because rates interact: an open-rate gain and a conversion-rate gain don't stack the way adding their
        totals suggests. Testing levers in isolation keeps the arithmetic honest about what any single
        improvement is actually worth at your numbers.
      </p>
      <p>
        One assumption is kept deliberately separate from the rest: bounce rate. Mail that never arrives is a
        list-hygiene matter, not a campaign-performance one, and the calculator doesn't fold it into the
        improvement maths where it would flatter the numbers. <a href="/list-hygiene-small-businesses" class="link font-medium">Dead addresses and list hygiene</a> covers what to prune and when; <a href="/bounce-types-explained" class="link font-medium">what each bounce type costs you</a> breaks down the signals behind your bounce rate. Before your next send, the <a href="/tools/preflight-checklist" class="link font-medium">preflight checklist</a> catches the campaign-side faults that cost money quietly. If the number at the bottom of the funnel looks wrong for your business and you'd rather find out why than adjust assumptions, the <a href="/consultation" class="link font-medium">consultation</a> starts from exactly that question.
      </p>
    </div>
  </section>
  <!-- CTA -->

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Book Your Free Consultation', href: '/consultation' },
    ]}
    title="Seeing a number you don't like?"
    subtitle="The problems that cost you money are often the ones your dashboard doesn't show you."
  />

  <!-- More tools -->

  <section id="more-tools" class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold dark:text-white">More tools</h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
        Free, browser-based, nothing to sign up for.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href="/tools/auth-checker"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Email authentication checker</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Check any domain's SPF, DKIM and DMARC — records shown, interpreted in plain English.
        </p>
      </a>
      <a
        href="/tools/dmarc-report-viewer"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">DMARC report viewer</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Upload the aggregate report your inbox provider sends you — get plain English back on who's sending as you.
        </p>
      </a>
      <a
        href="/tools/preflight-checklist"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Preflight checklist</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Ten checks to run before every campaign send — verified in minutes, before your sender reputation pays.
        </p>
      </a>
      <a
        href="/tools/spf-generator"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">SPF record generator</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Build your SPF record sender by sender, watching the lookup budget as you go.
        </p>
      </a>
    </div>
  </section>

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<script>
// --- ROI Calculator ---------------------------------------------------------
// DOM acquisition and listener binding live in init() for ClientRouter soft
// navigation; the dataset guard prevents duplicate listeners.
// Results render only on Calculate — intentionally not on page load.

  // --- Configuration ------------------------------------------------------------
  const PACKAGE_FEE = 199;
  const TRIGGER_THRESHOLD = 400;

  const gbp = new Intl.NumberFormat('en-GB', {
    style: 'currency',
    currency: 'GBP',
    maximumFractionDigits: 0,
  });

  // --- DOM ----------------------------------------------------------------------
  // Field references, populated by init() — acquired fresh on every page
  // load event so soft-navigated pages bind to their own (new) elements.
  let fields: {
    listSize: HTMLInputElement | null;
    sendFrequency: HTMLInputElement | null;
    openRate: HTMLInputElement | null;
    clickRate: HTMLInputElement | null;
    conversionRate: HTMLInputElement | null;
    customerValue: HTMLInputElement | null;
    bounceRate: HTMLInputElement | null;
    button: HTMLButtonElement | null;
    results: HTMLElement | null;
  };

  function num(el: HTMLInputElement, fallback: number): number {
    const v = parseFloat(el.value);
    return Number.isFinite(v) && v >= 0 ? v : fallback;
  }

  function funnel(inputs: {
    list: number;
    sends: number;
    openPct: number;
    clickPct: number;
    convPct: number;
    value: number;
    bouncePct: number;
  }) {
    const emails = inputs.list * inputs.sends;
    const delivered = emails * (1 - inputs.bouncePct / 100);
    const opened = delivered * (inputs.openPct / 100);
    const clicked = opened * (inputs.clickPct / 100);
    const customers = clicked * (inputs.convPct / 100);
    return { emails, delivered, opened, clicked, customers, revenue: customers * inputs.value };
  }

  let baseline: ReturnType<typeof funnel> | null = null;
  let baselineInputs: Parameters<typeof funnel>[0] | null = null;

  function recalculateSensitivities() {
    if (!baseline || !baselineInputs) return;
    const levers = [
      { key: 'open', label: 'Open rate', current: baselineInputs.openPct },
      { key: 'click', label: 'Click rate', current: baselineInputs.clickPct },
      { key: 'conv', label: 'Conversion rate', current: baselineInputs.convPct },
    ];
    for (const lever of levers) {
      const ppEl = document.getElementById(`sens-${lever.key}-pp`) as HTMLInputElement | null;
      const outEl = document.getElementById(`sens-${lever.key}-result`) as HTMLElement | null;
      if (!ppEl || !outEl) continue;
      const pp = parseFloat(ppEl.value);
      if (!Number.isFinite(pp) || pp <= 0) {
        outEl.textContent = '—';
        continue;
      }
      const mod = { ...baselineInputs };
      if (lever.key === 'open') mod.openPct = Math.min(100, baselineInputs.openPct + pp);
      if (lever.key === 'click') mod.clickPct = Math.min(100, baselineInputs.clickPct + pp);
      if (lever.key === 'conv') mod.convPct = Math.min(100, baselineInputs.convPct + pp);
      const run = funnel(mod);
      const delta = run.revenue - baseline.revenue;
      outEl.textContent = `${gbp.format(delta)}/month`;
    }
  }

  function calculate() {
    const inputs = {
      list: Math.max(0, num(fields.listSize, 0)),
      sends: Math.max(0, num(fields.sendFrequency, 0)),
      openPct: Math.min(100, num(fields.openRate, 0)),
      clickPct: Math.min(100, num(fields.clickRate, 0)),
      convPct: Math.min(100, num(fields.conversionRate, 0)),
      value: Math.max(0, num(fields.customerValue, 0)),
      bouncePct: Math.min(100, num(fields.bounceRate, 0)),
    };
    const run = funnel(inputs);
    baseline = run;
    baselineInputs = inputs;

    const fmt = (n: number) => Math.round(n).toLocaleString('en-GB');

    const bounced = run.emails * (inputs.bouncePct / 100);
    const lostToBounces = bounced * (inputs.openPct / 100) * (inputs.clickPct / 100) * (inputs.convPct / 100) * inputs.value;

    const rows: string[] = [
      `Emails sent per month: <strong>${fmt(run.emails)}</strong> (${fmt(inputs.list)} subscribers × ${inputs.sends} sends)`,
      `Reaching an inbox: <strong>${fmt(run.delivered)}</strong> (${fmt(bounced)} bounced — a list-hygiene matter, not money better sending recovers)`,
      `Opened: <strong>${fmt(run.opened)}</strong> (${inputs.openPct}% open rate, treated as approximate)`,
      `Clicked: <strong>${fmt(run.clicked)}</strong> (${inputs.clickPct}% of opens)`,
      `Converted: <strong>${fmt(run.customers)}</strong> customers (${inputs.convPct}% of clicks)`,
      `Revenue this month: <strong>${gbp.format(run.revenue)}</strong> (${fmt(run.customers)} × ${gbp.format(inputs.value)})`,
    ];

    const hygieneLine =
      inputs.bouncePct > 0
        ? `<p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Mail that bounced would have earned roughly ${gbp.format(lostToBounces)}/month at your current rates. That money comes back through cleaning the list, not through sending better — and a sustained high bounce rate damages the sender reputation everything above depends on.</p>`
        : '';

    // Responsive reflow: below sm, table cells stack vertically as cards and
    // column labels are shown inline per cell (sm:hidden spans); at sm and
    // above, normal table layout with the visible thead. Same IDs, same logic.
    const mobileLabel = (text: string) =>
      `<span class="sm:hidden block text-[11px] uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-1">${text}</span>`;

    const sensRow = (key: string, label: string, current: number) => `
      <tr class="block sm:table-row border-b border-slate-200 dark:border-slate-700 last:border-b-0 pb-4 sm:pb-0">
        <td class="block sm:table-cell py-1 sm:py-2 pr-2 font-medium dark:text-white">
          ${mobileLabel('Lever')}
          ${label}
        </td>
        <td class="block sm:table-cell py-1 sm:py-2 pr-2 text-slate-600 dark:text-slate-300">
          ${mobileLabel('Current')}
          ${current}%
        </td>
        <td class="block sm:table-cell py-1 sm:py-2 pr-2">
          ${mobileLabel('Improve by')}
          <div class="flex items-center gap-1">
            <span class="text-slate-500 dark:text-slate-400">+</span>
            <input
              id="sens-${key}-pp"
              type="number"
              min="0.1"
              step="0.5"
              placeholder="5"
              class="w-16 rounded border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <span class="text-slate-500 dark:text-slate-400 text-sm">points</span>
          </div>
        </td>
        <td id="sens-${key}-result" class="block sm:table-cell py-1 sm:py-2 sm:text-right font-semibold dark:text-white whitespace-nowrap">
          ${mobileLabel('Extra revenue')}
          —
        </td>
      </tr>`;

    const sensitivityHtml = `
      <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-4 mt-4">
        <h3 class="font-bold text-lg dark:text-white mb-1">What would improvement be worth?</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 mb-3">
          Enter an improvement in percentage points for any rate and see what it earns at your numbers.
          Each lever is tested alone.
        </p>
        <div>
          <table class="w-full text-sm block sm:table">
            <thead class="hidden sm:table-header-group">
              <tr class="text-left text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
                <th class="pb-2">Lever</th>
                <th class="pb-2">Current</th>
                <th class="pb-2">Improve by</th>
                <th class="pb-2 text-right">Extra revenue</th>
              </tr>
            </thead>
            <tbody class="block sm:table-row-group">
              ${sensRow('open', 'Open rate', inputs.openPct)}
              ${sensRow('click', 'Click rate', inputs.clickPct)}
              ${sensRow('conv', 'Conversion rate', inputs.convPct)}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-3">
          These are your numbers, your assumptions — the calculator just does the arithmetic.
        </p>
      </div>`;

    const evaluateTrigger = (): { label: string; delta: number } | null => {
      if (!baselineInputs) return null;
      const defs = [
        { key: 'open', label: 'open rate', apply: (m: Parameters<typeof funnel>[0], pp: number) => (m.openPct = Math.min(100, m.openPct + pp)) },
        { key: 'click', label: 'click rate', apply: (m: Parameters<typeof funnel>[0], pp: number) => (m.clickPct = Math.min(100, m.clickPct + pp)) },
        { key: 'conv', label: 'conversion rate', apply: (m: Parameters<typeof funnel>[0], pp: number) => (m.convPct = Math.min(100, m.convPct + pp)) },
      ];
      let best: { label: string; delta: number } | null = null;
      for (const d of defs) {
        const ppEl = document.getElementById(`sens-${d.key}-pp`) as HTMLInputElement | null;
        if (!ppEl) continue;
        const pp = parseFloat(ppEl.value);
        if (!Number.isFinite(pp) || pp <= 0) continue;
        const mod = { ...baselineInputs };
        d.apply(mod, pp);
        const delta = funnel(mod).revenue - run.revenue;
        if (!best || delta > best.delta) best = { label: d.label, delta };
      }
      return best;
    };

    function renderVerdict(best: { label: string; delta: number } | null) {
      const el = document.getElementById('package-trigger');
      if (!el) return;
      if (best && best.delta >= TRIGGER_THRESHOLD) {
        el.innerHTML = `
          <div class="rounded-lg bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-700 p-4 text-center">
            <p class="text-sm text-slate-600 dark:text-slate-300">Improving your ${esc(best.label)} by your assumed amount is worth</p>
            <p class="font-bold text-3xl dark:text-white mt-1">${gbp.format(best.delta)} <span class="text-base font-normal">/ month</span></p>
            <p class="text-sm text-slate-600 dark:text-slate-300 mt-3">A £${PACKAGE_FEE} review and strategy package — the full audit plus a prioritised plan for your domain — can help you realise improvements like this in your bottom line.</p>
            <a href="/contact" class="btn btn-primary inline-block mt-3 px-5 py-2.5 rounded-lg font-medium">Enquire About the £${PACKAGE_FEE} Package</a>
          </div>`;
      } else {
        el.innerHTML = `
          <p class="text-sm text-slate-500 dark:text-slate-400 text-center mt-4">
            At these numbers, modest improvements to individual rates don't move the needle much.
            If email isn't earning its keep, list size or customer value is likely the bigger constraint.
          </p>`;
      }
    }

    fields.results.innerHTML = `
      <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-4">
        <h3 class="font-bold text-lg dark:text-white mb-2">How the estimate is built</h3>
        <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1 list-disc pl-5">
          ${rows.map((r) => `<li>${r}</li>`).join('')}
        </ul>
        ${hygieneLine}
      </div>
      ${sensitivityHtml}
      <div id="package-trigger" class="mt-4"></div>`;

    const sensInputs = document.querySelectorAll<HTMLInputElement>('input[id^="sens-"]');
    sensInputs.forEach((el) => {
      el.addEventListener('input', () => {
        recalculateSensitivities();
        renderVerdict(evaluateTrigger());
      });
    });
    recalculateSensitivities();
    renderVerdict(evaluateTrigger());
  }

  function esc(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string,
    );
  }

  // --- View Transitions binding (v1.1) — see header comment ------------------

  function init() {
    const button = document.getElementById('calc-button') as HTMLButtonElement | null;
    if (!button || button.dataset.initDone === 'true') return;
    button.dataset.initDone = 'true';

    fields = {
      listSize: document.getElementById('list-size') as HTMLInputElement,
      sendFrequency: document.getElementById('send-frequency') as HTMLInputElement,
      openRate: document.getElementById('open-rate') as HTMLInputElement,
      clickRate: document.getElementById('click-rate') as HTMLInputElement,
      conversionRate: document.getElementById('conversion-rate') as HTMLInputElement,
      customerValue: document.getElementById('customer-value') as HTMLInputElement,
      bounceRate: document.getElementById('bounce-rate') as HTMLInputElement,
      button: button,
      results: document.getElementById('results') as HTMLElement,
    };

    button.addEventListener('click', calculate);
  }

  const pageInit = (window as any).pageInit as ((fn: () => void) => void) | undefined;
  if (typeof pageInit === 'function') {
    pageInit(init);
  } else {
    // Fallback if the layout helper is ever absent: bind directly and
    // listen for astro:page-load ourselves (same guard makes this safe).
    init();
    document.addEventListener('astro:page-load', init);
  }
</script>
