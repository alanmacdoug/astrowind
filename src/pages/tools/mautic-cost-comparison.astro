---
import Layout from '~/layouts/PageLayout.astro';

import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'Mautic Cost Comparison',
  description:
    'Compare managed Mautic hosting (including delivery costs) against tiered ESP pricing as your list grows. See the break-even point and the annual difference.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

  <Hero
  tagline="Tools"
  title="Managed Mautic vs tiered ESP pricing"
  subtitle="Hosted email platforms charge by contact count; managed Mautic pairs a flat hosting fee with pay-per-send delivery. Enter your list size, sending frequency and delivery vendor, and see where the total costs cross."
  compact={true}
/>

  <!-- The calculator (slate-100) -->

  <section id="mautic-compare" class="relative bg-slate-100 dark:bg-transparent">
    <div class="px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-4xl">
      <div
        class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 sm:p-8"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Subscribers</span>
            <input
              id="subs"
              type="number"
              min="100"
              max="500000"
              step="100"
              value="25000"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Managed Mautic monthly fee (£)</span>
            <input
              id="mautic-fee"
              type="number"
              min="0"
              value="75"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Emails per subscriber / month</span>
            <input
              id="eps"
              type="number"
              min="1"
              max="100"
              value="4"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </label>

          <label class="block">
            <span class="block text-sm font-medium dark:text-white mb-1">Delivery vendor (Mautic sends)</span>
            <select
              id="vendor"
              class="w-full rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-primary"
            ></select>
          </label>

          <fieldset class="sm:col-span-2">
            <legend class="text-sm font-medium dark:text-white mb-2">
              Hosted ESP to compare (indicative tier pricing)
            </legend>
            <div id="platform-selects" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
          </fieldset>
        </div>

        <button
          type="button"
          id="calc-btn"
          class="btn btn-primary font-medium rounded-lg px-6 py-3 mt-6 w-full sm:w-auto"
        >
          Compare
        </button>

        <div id="results" class="mt-8"></div>
        <div id="chart-area" class="mt-6"></div>
      </div>

      <p class="relative text-center text-xs text-slate-600 dark:text-slate-400 mt-4">
        Runs entirely in your browser — nothing is sent or stored. Delivery vendor figures for SendGrid are vendor-verified (Twilio pricing page, 2026); Brevo figures from Brevo's help centre, Postmark from third-party reporting (2026). ESP tier prices (Mailchimp Standard, ActiveCampaign Starter) verified September 2026 against published vendor and third-party pricing, converted from USD at ~$1.30/£; ActiveCampaign figures are annual-billing rates. Above the largest verified tier the model extrapolates — confirm exact prices in each vendor's pricing calculator. All figures indicative — always check current pricing with the vendor before any decision.
      </p>
    </div>
  </section>

  <!-- CTA -->

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Book Your Free Consultation', href: '/contact' },
    ]}
    title="Above the crossover?"
    subtitle="Managed Mautic with the delivery layer priced in, line by line — and you work with the person who runs the infrastructure."
  />

    <!-- More tools -->

  <section id="more-tools" class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold dark:text-white">More tools</h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
        Free, browser-based, nothing to sign up for.
      </p>
    </div>

       <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href="/tools/auth-checker"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Email authentication checker</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Check any domain's SPF, DKIM and DMARC — records shown, interpreted in plain English.
        </p>
      </a>
      <a
        href="/tools/dmarc-report-viewer"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">DMARC report viewer</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Upload the aggregate report your inbox provider sends you — get plain English back on who's sending as you.
        </p>
      </a>
      <a
        href="/tools/preflight-checklist"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Preflight checklist</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Ten checks to run before every campaign send — verified in minutes, before your sender reputation pays.
        </p>
      </a>
      <a
        href="/tools/spf-generator"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">SPF record generator</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Build your SPF record sender by sender, with the ten-lookup budget visible as you go.
        </p>
      </a>
      <a
        href="/tools/mautic-cost-comparison"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Mautic vs ESP cost comparison</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Managed Mautic against typical ESP pricing — find the subscriber count where the crossover happens.
        </p>
      </a>
    </div>
  </section>

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<script>
  // --- Mautic Cost Comparison — v1.1 ----------------------------------------
  // v1.1: View Transitions retrofit — DOM element acquisition, dynamic UI
  //       construction (vendor dropdown, platform checkboxes) and all event
  //       listeners moved into an init() function registered with the
  //       site-wide window.pageInit helper (Layout.astro). Module scripts
  //       execute once per full page load; ClientRouter soft navigations
  //       swap the DOM without re-running them, which left the form dead
  //       and the selects empty after internal navigation. init() rebuilds
  //       the dynamic UI on every astro:page-load; a dataset guard on the
  //       container prevents duplicated checkboxes and stacked listeners.
  //       All pricing data and calculation logic unchanged from v1.0.

  // --- Data: ESP tier pricing ---------------------------------------------------
  // VERIFIED ANCHORS — September 2026, converted to GBP at ~$1.30/£:
  //   Mailchimp Standard, monthly billing: $20 @ 500 contacts, $100 @ 5k,
  //     ~$135 @ 10k (sources: mailchimp.com/pricing via EmailToolTester /
  //     SAAS CRM Review / Groupmail, 2026).
  //   ActiveCampaign Starter, annual billing: $15 @ 1k, $79 @ 5k contacts
  //     (sources: activecampaign.com/pricing via RealCostLabs / CostBench,
  //     2026). Monthly billing runs ~25% higher; Starter is not offered
  //     above ~25k contacts.
  // Above the largest verified tier the model extrapolates by slope (see
  // espPriceFor) — vendors price larger lists via on-page calculators that
  // do not publish static figures. Check those calculators before quoting
  // prices above 10k contacts. Price fields on the page are display-only,
  // auto-filled from these tiers.
  const ESPS = [
    {
      id: 'mailchimp',
      name: 'Mailchimp (Standard plan)',
      tiers: [
        { upto: 500, price: 15 },
        { upto: 5000, price: 77 },
        { upto: 10000, price: 104 },
      ],
    },
    {
      id: 'activecampaign',
      name: 'ActiveCampaign (Starter plan)',
      tiers: [
        { upto: 1000, price: 12 },
        { upto: 5000, price: 61 },
      ],
    },
  ];

  // --- Data: delivery vendors (Mautic side) ------------------------------------
  const DELIVERY_VENDORS = [
    {
      id: 'sendgrid',
      name: 'SendGrid',
      labelSummary: 'free trial only, then £16 incl. 100k sends, overage £0.90/1k',
      freeAllowance: 0,
      planPrice: 16,
      planAllowance: 100000,
      overagePerThousand: 0.90,
      linearOnly: false,
    },
    {
      id: 'ses',
      name: 'Amazon SES',
      labelSummary: 'pure linear ~£0.08/1,000, no free tier for new accounts',
      perThousand: 0.08,
      linearOnly: true,
    },
    {
      id: 'brevo',
      name: 'Brevo',
      labelSummary: 'free to 9k/mo, then £16 incl. 20k, overage £1.10/1k',
      freeAllowance: 9000,
      planPrice: 16,
      planAllowance: 20000,
      overagePerThousand: 1.10,
      linearOnly: false,
    },
    {
      id: 'postmark',
      name: 'Postmark',
      labelSummary: '100/mo testing free, then ~£16 incl. 10k, overage £1.40/1k',
      freeAllowance: 100,
      planPrice: 16,
      planAllowance: 10000,
      overagePerThousand: 1.40,
      linearOnly: false,
    },
  ];

  const MAUTIC_FEE_DEFAULT = 75;
  const EMAILS_PER_SUBSCRIBER_DEFAULT = 4;
  const MAX_SUBS = 100000;

  // --- DOM ---------------------------------------------------------------------
  // References and dynamic UI state, populated by init() — acquired/rebuilt
  // fresh on every page load event so soft-navigated pages bind to their own
  // (new) elements instead of stale ones from the previous page.

  let fields: {
    subs: HTMLInputElement | null;
    mauticFee: HTMLInputElement | null;
    eps: HTMLInputElement | null;
    vendor: HTMLSelectElement | null;
    calcBtn: HTMLButtonElement | null;
    results: HTMLElement | null;
    chartArea: HTMLElement | null;
    platformSelects: HTMLElement | null;
  };

  let espCheckboxes: HTMLInputElement[] = [];
  const espPriceInputs: Record<string, HTMLInputElement> = {};

  function buildUI() {
    fields = {
      subs: document.getElementById('subs') as HTMLInputElement | null,
      mauticFee: document.getElementById('mautic-fee') as HTMLInputElement | null,
      eps: document.getElementById('eps') as HTMLInputElement | null,
      vendor: document.getElementById('vendor') as HTMLSelectElement | null,
      calcBtn: document.getElementById('calc-btn') as HTMLButtonElement | null,
      results: document.getElementById('results'),
      chartArea: document.getElementById('chart-area'),
      platformSelects: document.getElementById('platform-selects'),
    };
    if (!fields.vendor || !fields.platformSelects) return;

    // Populate the delivery-vendor dropdown with shape summaries
    for (const v of DELIVERY_VENDORS) {
      const opt = document.createElement('option');
      opt.value = v.id;
      opt.textContent = v.name + ' — ' + v.labelSummary;
      if (v.id === 'sendgrid') opt.selected = true;
      fields.vendor.appendChild(opt);
    }

    // Build platform checkboxes with a tier summary and display-only price field
    espCheckboxes = [];

    for (const esp of ESPS) {
      const wrap = document.createElement('div');
      wrap.className = 'flex items-start gap-3';

      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.checked = esp.id === 'mailchimp';
      cb.id = esp.id + '-cb';
      cb.className = 'mt-1 h-4 w-4';
      espCheckboxes.push(cb);

      const lbl = document.createElement('label');
      lbl.htmlFor = cb.id;
      lbl.className = 'flex-1 text-sm text-slate-600 dark:text-slate-300 cursor-pointer';

      const nameSpan = document.createElement('span');
      nameSpan.className = 'block font-medium dark:text-white';
      nameSpan.textContent = esp.name;

      const tierSummary = document.createElement('span');
      tierSummary.className = 'block text-xs mt-1';
      tierSummary.textContent = esp.tiers
        .map(function(t) { return t.upto.toLocaleString() + '+: £' + t.price + '/mo'; })
        .join(' · ');

      const priceInput = document.createElement('input');
      priceInput.type = 'number';
      priceInput.min = '0';
      priceInput.value = '';
      priceInput.readOnly = true;
      priceInput.tabIndex = -1;
      priceInput.title =
        'Monthly price at the current subscriber count (auto-filled from the tier table)';
      priceInput.className =
        'w-24 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-800 dark:text-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary opacity-80';
      espPriceInputs[esp.id] = priceInput;

      lbl.appendChild(nameSpan);
      lbl.appendChild(tierSummary);
      wrap.appendChild(cb);
      wrap.appendChild(lbl);
      wrap.appendChild(priceInput);
      fields.platformSelects.appendChild(wrap);
    }
  }

  // --- Pricing functions --------------------------------------------------------

  function espPriceFor(esp, subs) {
    for (const t of esp.tiers) {
      if (subs <= t.upto) return t.price;
    }
    const last = esp.tiers[esp.tiers.length - 1];
    const prev = esp.tiers[esp.tiers.length - 2];
    const slope = (last.price - prev.price) / (last.upto - prev.upto);
    return last.price + slope * (subs - last.upto);
  }

  function selectedVendor() {
    const v = DELIVERY_VENDORS.find(function(d) { return d.id === fields.vendor.value; });
    return v || DELIVERY_VENDORS[0];
  }

  function vendorName() {
    return selectedVendor().name;
  }

  function deliveryCost(sends) {
    const v = selectedVendor();

    if (v.linearOnly) {
      const cost = (sends / 1000) * v.perThousand;
      return {
        cost: cost,
        breakdown: 'Linear delivery @ £' + v.perThousand.toFixed(2) + '/1k sends: £' + cost.toFixed(0) + '/mo',
      };
    }

    const freeAllowance = v.freeAllowance;
    const planPrice = v.planPrice;
    const planAllowance = v.planAllowance;
    const overagePerThousand = v.overagePerThousand;

    if (sends <= freeAllowance) {
      return { cost: 0, breakdown: 'Free tier covers ' + sends.toLocaleString() + ' sends: £0/mo' };
    }

    if (sends <= planAllowance) {
      return {
        cost: planPrice,
        breakdown: 'Plan price: £' + planPrice + '/mo (includes up to ' + planAllowance.toLocaleString() + ' sends)',
      };
    }

    const overageSends = sends - planAllowance;
    const overageCost = (overageSends / 1000) * overagePerThousand;
    const total = planPrice + overageCost;
    return {
      cost: total,
      breakdown: 'Plan £' + planPrice + ' + £' + overageCost.toFixed(0) + ' overage (' + overageSends.toLocaleString() + ' sends × £' + overagePerThousand.toFixed(2) + '/1k): £' + total.toFixed(0) + '/mo',
    };
  }

  function mauticTotal(subs, eps, fee) {
    const sends = subs * eps;
    const deliveryResult = deliveryCost(sends);
    const total = fee + deliveryResult.cost;
    return { total: total, delivery: deliveryResult.cost, deliveryBreakdown: deliveryResult.breakdown };
  }

  function findBreakEven(esp, mauticFee, eps) {
    const step = 100;
    for (let s = step; s <= MAX_SUBS * 4; s += step) {
      if (espPriceFor(esp, s) > mauticTotal(s, eps, mauticFee).total) return s;
    }
    return null;
  }

  // --- Chart ----------------------------------------------------------------------

  const gbp = new Intl.NumberFormat('en-GB', {
    style: 'currency',
    currency: 'GBP',
    maximumFractionDigits: 0,
  });

  function renderChart(subs, mauticFee, eps, activeEsps) {
    const W = 640;
    const H = 320;
    const PAD_L = 48;
    const PAD_B = 36;
    const PAD_T = 16;
    const PAD_R = 16;

    const xMax = MAX_SUBS;
    const yMax = 1000;

    const x = function(s) { return PAD_L + (s / xMax) * (W - PAD_L - PAD_R); };
    const y = function(p) { return H - PAD_B - (Math.min(p, yMax) / yMax) * (H - PAD_B - PAD_T); };

    const totAtMax = mauticTotal(MAX_SUBS, eps, mauticFee).total;

    let svg = '<svg viewBox="0 0 ' + W + ' ' + H + '" class="w-full h-auto" role="img" aria-label="Monthly total cost versus subscriber count">';

    for (const s of [0, 25000, 50000, 75000, 100000]) {
      svg += '<line x1="' + x(s) + '" y1="' + PAD_T + '" x2="' + x(s) + '" y2="' + (H - PAD_B) + '" stroke="currentColor" stroke-opacity="0.1"/>';
      svg += '<text x="' + x(s) + '" y="' + (H - PAD_B + 18) + '" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.6">' + (s / 1000) + 'k</text>';
    }
    for (const p of [0, 250, 500, 750, 1000]) {
      svg += '<line x1="' + PAD_L + '" y1="' + y(p) + '" x2="' + (W - PAD_R) + '" y2="' + y(p) + '" stroke="currentColor" stroke-opacity="0.1"/>';
      svg += '<text x="' + (PAD_L - 6) + '" y="' + (y(p) + 4) + '" text-anchor="end" font-size="11" fill="currentColor" opacity="0.6">£' + p + '</text>';
    }

    svg += '<line x1="' + x(0) + '" y1="' + y(mauticFee) + '" x2="' + x(MAX_SUBS) + '" y2="' + y(totAtMax) + '" stroke="#6d4aff" stroke-width="2.5"/>';
    svg += '<text x="' + x(MAX_SUBS) + '" y="' + (y(totAtMax) - 6) + '" text-anchor="end" font-size="11" fill="#6d4aff">Mautic total (hosting + delivery)</text>';

    const espColours = ['#ef4444', '#f59e0b'];
    activeEsps.forEach(function(esp, i) {
      const colour = espColours[i % espColours.length];
      let path = 'M ' + x(0) + ' ' + y(espPriceFor(esp, 1));
      for (let s = 0; s <= xMax; s += 500) {
        path += ' L ' + x(s) + ' ' + y(espPriceFor(esp, s));
      }
      svg += '<path d="' + path + '" fill="none" stroke="' + colour + '" stroke-width="2"/>';
      svg += '<text x="' + x(1000) + '" y="' + (y(espPriceFor(esp, 1000)) - 8) + '" font-size="11" fill="' + colour + '">' + esp.name + '</text>';
    });

    svg += '<line x1="' + x(subs) + '" y1="' + PAD_T + '" x2="' + x(subs) + '" y2="' + (H - PAD_B) + '" stroke="#0ea5e9" stroke-width="1.5" stroke-dasharray="4 4"/>';
    svg += '<text x="' + x(subs) + '" y="' + (PAD_T + 12) + '" text-anchor="middle" font-size="11" fill="#0ea5e9">Your list (' + subs.toLocaleString() + ')</text>';

    svg += '</svg>';
    return svg;
  }

  // --- Main calculation -------------------------------------------------------------

  const crossoverNote =
    '<p class="text-xs text-slate-500 dark:text-slate-400 mt-4">' +
    'Delivery cost rises linearly with sends, while tiered ESP pricing jumps in steps at contact' +
    'thresholds — so the gap between the two opens and closes at each boundary. Read the break-even' +
    'figure rather than assuming the gap only widens.' +
    '</p>';

  function calculate() {
    const subs = Math.max(100, parseInt(fields.subs.value, 10) || 100);
    const mauticFeeRaw = parseFloat(fields.mauticFee.value);
    const mauticFee = Number.isFinite(mauticFeeRaw) ? Math.max(0, mauticFeeRaw) : MAUTIC_FEE_DEFAULT;
    const eps = Math.max(1, parseInt(fields.eps.value, 10) || EMAILS_PER_SUBSCRIBER_DEFAULT);

    const sends = subs * eps;
    const mauticResult = mauticTotal(subs, eps, mauticFee);
    const vName = vendorName();

    const activeEsps = ESPS.filter(function(_, i) { return espCheckboxes[i].checked; });

    const summaryHtml =
      '<div class="rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 text-sm text-slate-600 dark:text-slate-300 mb-4">' +
      subs.toLocaleString() + ' subscribers × ' + eps + ' emails ≈ <strong class="dark:text-white">' + sends.toLocaleString() + '</strong> sends/month<br />' +
      'Delivery via ' + vName + ': <strong class="dark:text-white">' + mbreakdown(mauticResult.deliveryBreakdown) + '</strong><br />' +
      'Managed Mautic total: <strong class="dark:text-white">' + gbp.format(mauticResult.total) + '/mo</strong> (' + gbp.format(mauticFee) + ' hosting + ' + gbp.format(mauticResult.delivery) + ' delivery)' +
      '</div>';

    let tableHtml =
      '<div class="overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">' +
      '<table class="w-full text-sm">' +
      '<thead>' +
      '<tr class="text-left border-b border-slate-200 dark:border-slate-700 dark:text-slate-300">' +
      '<th class="p-3">Platform</th>' +
      '<th class="p-3 text-right">Monthly total at ' + subs.toLocaleString() + ' subs</th>' +
      '<th class="p-3 text-right">vs Mautic total</th>' +
      '<th class="p-3 text-right">Annual difference</th>' +
      '</tr>' +
      '</thead>' +
      '<tbody>';

    for (const esp of activeEsps) {
      const price = espPriceFor(esp, subs);
      espPriceInputs[esp.id].value = String(Math.round(price));
      const diff = price - mauticResult.total;
      const annual = diff * 12;
      const be = findBreakEven(esp, mauticFee, eps);
      const diffCell = diff > 0
        ? '<span class="text-red-600 dark:text-red-400 font-semibold">+' + gbp.format(diff) + '</span>'
        : '<span class="text-emerald-600 dark:text-emerald-400 font-semibold">' + gbp.format(diff) + '</span>';
      tableHtml +=
        '<tr class="border-b border-slate-100 dark:border-slate-800">' +
        '<td class="p-3 dark:text-white">' + esp.name + '<br /><span class="text-xs text-slate-500 dark:text-slate-400">Break-even: ' + (be ? be.toLocaleString() + ' subscribers' : 'never at these fees') + '</span></td>' +
        '<td class="p-3 text-right dark:text-white">' + gbp.format(price) + '</td>' +
        '<td class="p-3 text-right">' + diffCell + '</td>' +
        '<td class="p-3 text-right dark:text-white">' + gbp.format(annual) + '</td>' +
        '</tr>';
    }

    tableHtml +=
      '<tr class="border-t-2 border-slate-200 dark:border-slate-700 dark:text-white">' +
      '<td class="p-3 font-semibold">Managed Mautic (hosting + delivery)<br /><span class="text-xs font-normal text-slate-500 dark:text-slate-400">' + gbp.format(mauticFee) + ' hosting + ' + gbp.format(mauticResult.delivery) + ' delivery via ' + vName + '</span></td>' +
      '<td class="p-3 text-right font-semibold">' + gbp.format(mauticResult.total) + '</td>' +
      '<td class="p-3 text-right">—</td>' +
      '<td class="p-3 text-right">—</td>' +
      '</tr>' +
      '</tbody>' +
      '</table>' +
      '</div>';

    const worstDiff = Math.max(0, ...activeEsps.map(function(e) { return espPriceFor(e, subs) - mauticResult.total; }));

    let verdictHtml = '';
    if (worstDiff > 0 && activeEsps.length > 0) {
      verdictHtml =
        '<div class="rounded-lg bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-700 p-4 text-center mt-4">' +
        '<p class="font-semibold text-lg dark:text-white">You are above the crossover</p>' +
        '<p class="text-sm text-slate-600 dark:text-slate-300 mt-1">At ' + subs.toLocaleString() + ' subscribers and ' + sends.toLocaleString() + ' sends/month, the Mautic total of ' + gbp.format(mauticResult.total) + '/month is the cheaper option at these fees.</p>' +
        '<a href="/contact" class="btn btn-primary inline-block mt-3 px-5 py-2.5 rounded-lg font-medium">Discuss Managed Mautic Hosting</a>' +
        '</div>';
    } else if (activeEsps.length > 0) {
      verdictHtml =
        '<div class="rounded-lg bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-700 p-4 text-center mt-4">' +
        '<p class="font-semibold text-lg dark:text-white">Below the crossover — the ESP is cheaper for now</p>' +
        '<p class="text-sm text-slate-600 dark:text-slate-300 mt-1">At ' + subs.toLocaleString() + ' subscribers, tiered pricing has not yet overtaken the Mautic total of ' + gbp.format(mauticResult.total) + '/month. The break-even point tells you when it will.</p>' +
        '</div>';
    }

    fields.results.innerHTML = summaryHtml + tableHtml + verdictHtml + crossoverNote;
    if (activeEsps.length > 0) {
      fields.chartArea.innerHTML = renderChart(subs, mauticFee, eps, activeEsps);
    } else {
      fields.chartArea.innerHTML = '<p class="text-sm text-slate-500 dark:text-slate-400">Select at least one platform to compare.</p>';
    }
  }

  function mbreakdown(html) {
    const match = html.match(/:(.*)$/);
    return match ? match[1].trim() : html;
  }

  // --- View Transitions binding (v1.1) — see header comment ------------------

  function init() {
    const container = document.getElementById('platform-selects');
    if (!container || container.dataset.initDone === 'true') return;
    container.dataset.initDone = 'true';

    buildUI();

    fields.calcBtn.addEventListener('click', calculate);
    fields.subs.addEventListener('input', calculate);
    fields.mauticFee.addEventListener('input', calculate);
    fields.eps.addEventListener('input', calculate);
    fields.vendor.addEventListener('change', calculate);
    calculate();
  }

  const pageInit = (window as any).pageInit as ((fn: () => void) => void) | undefined;
  if (typeof pageInit === 'function') {
    pageInit(init);
  } else {
    // Fallback if the layout helper is ever absent: bind directly and
    // listen for astro:page-load ourselves (same guard makes this safe).
    init();
    document.addEventListener('astro:page-load', init);
  }
</script>
