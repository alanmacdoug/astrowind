---
import Layout from '~/layouts/PageLayout.astro';

import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'DMARC Report Viewer',
  description:
    'Upload a DMARC aggregate report XML file and get plain English back — who sends as your domain, who passes, and what your policy actually means.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->

  <Hero
    tagline="Tools"
    title="Read the report your inbox provider sends you"
    subtitle="Upload a DMARC aggregate report and get plain English back — who sends as your domain, who passes, and what your policy actually means. Runs entirely in your browser."
    compact={true}
  />

  <!-- The viewer (slate-100) -->

  <section id="dmarc-viewer" class="relative bg-slate-100 dark:bg-transparent">
    <div class="px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
      <div
        class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 sm:p-8"
      >
        <div class="mb-6">
          <label for="report-file" class="block text-sm font-medium dark:text-white mb-2">
            Select your DMARC aggregate report
          </label>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">
            Accepts .xml, .xml.gz, or .zip files from Gmail, Outlook, Yahoo, Proofpoint, or similar providers.
          </p>
          <input
            id="report-file"
            type="file"
            accept=".xml,.xml.gz,.zip"
            class="block w-full text-sm text-slate-500 dark:text-slate-400
              file:mr-4 file:py-3 file:px-4
              file:rounded-md file:border-0
              file:text-sm file:font-semibold
              file:bg-slate-100 file:text-slate-700
              hover:file:bg-slate-200
              dark:file:bg-slate-800 dark:file:text-slate-300
              cursor-pointer"
          />
        </div>

        <button
          type="button"
          id="parse-btn"
          class="btn btn-primary font-medium rounded-lg px-6 py-3 mt-2 w-full sm:w-auto"
        >
          Parse report
        </button>

        <div id="loading" class="hidden mt-6 text-center">
          <p class="text-sm text-slate-600 dark:text-slate-300">Parsing XML...</p>
        </div>

        <div id="results" class="mt-8 hidden">
          <!-- Results inserted here by script -->
        </div>

        <div id="error" class="hidden mt-6 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 rounded-lg">
          <p id="error-text" class="text-sm text-red-700 dark:text-red-400"></p>
        </div>
      </div>

      <p class="relative text-center text-xs text-slate-600 dark:text-slate-400 mt-4">
        Runs entirely in your browser — nothing is sent or stored. Aggregate reports are sampled, not exhaustive, and reporting practices vary by provider — a clean report reduces risk, it does not eliminate it. Provider reporting practices vary.
      </p>
    </div>
  </section>
  <!-- About this tool -->
  <section id="about-this-tool" class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold dark:text-white">Why the plain English comes first</h2>
    </div>
    <div class="space-y-4 text-slate-600 dark:text-slate-300">
      <p>
        A DMARC aggregate report is a machine-to-machine document. Providers batch up everything that claimed to
        be your domain over roughly the last day, compress it, and send it to wherever your DNS record points.
        The format is efficient, not readable: counts against source IPs, pass and fail flags, a policy summary,
        all in nested XML. Reading one by hand is possible in the way reading a ledger by candlelight is possible.
      </p>
      <p>
        So this viewer puts the interpretation ahead of the data. The verdict line comes first — what your policy
        is set to, roughly what share of sampled messages passed, whether enforcement acted on anything — because
        those are the questions you actually brought the report here to answer. The table beneath it carries the
        detail, sorted by volume, with each source's authentication results spelled out rather than coded. When
        the envelope-from and the From: your recipients saw disagree, both are kept in view, because that
        disagreement is itself the finding.
      </p>
      <p>
        One habit worth forming: run reports from more than one provider if you receive them. Sampling differs
        between reporters, so a Google report and a Microsoft report over the same period are two pictures of the
        same traffic, and the differences between them are informative.
      </p>
      <p>
        Once you can read what the reports say, the <a href="/tools/auth-checker" class="link font-medium">email authentication checker</a> shows the DNS records behind those results, and the <a href="/tools/spf-generator" class="link font-medium">SPF record generator</a> rebuilds the record most reports end up prompting. Both are free. If you would rather the reading, the diagnosis and the fix were handled in one pass, the <a href="/consultation" class="link font-medium">audit</a> covers all three from your live sending data.
      </p>
    </div>
  </section>
  <!-- CTA -->

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Book Your Free Consultation', href: '/consultation' }
    ]}
    title="Your policy is set to monitoring?"
    subtitle="DMARC reports tell you who is sending as your domain. If you're not acting on what they say, that's the gap between monitoring and enforcement."
  />

  <!-- More tools -->

  <section id="more-tools" class="relative px-4 py-12 sm:px-6 mx-auto lg:px-8 max-w-3xl">
    <div class="text-center mb-6">
      <h2 class="text-2xl font-bold dark:text-white">More tools</h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
        Free, browser-based, nothing to sign up for.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href="/tools/auth-checker"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Email authentication checker</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Check any domain's SPF, DKIM and DMARC — records shown, interpreted in plain English.
        </p>
      </a>
      <a
        href="/tools/spf-generator"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">SPF record generator</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Build your SPF record sender by sender, with the ten-lookup budget visible as you go.
        </p>
      </a>
      <a
        href="/tools/preflight-checklist"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Preflight checklist</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Ten checks to run before every campaign send — verified in minutes, before your sender reputation pays.
        </p>
      </a>
      <a
        href="/tools/roi-calculator"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Deliverability ROI calculator</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          What is better email performance worth to you? Honest numbers out, every assumption shown.
        </p>
      </a>
      <a
        href="/tools/mautic-cost-comparison"
        class="group block rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 hover:border-primary dark:hover:border-primary transition-colors"
      >
        <h3 class="font-bold text-lg dark:text-white group-hover:text-primary">Mautic vs ESP cost comparison</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
          Managed Mautic against typical ESP pricing — find the subscriber count where the crossover happens.
        </p>
      </a>
    </div>
  </section>

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>

<script>
 // --- DMARC Aggregate Report Parser ---------------------------------------
// Parses standard DMARC aggregate reports (RFC 7489).
//
// Notes on quirks this parser has to handle:
// - Aggregate reports carry identity under identifiers/header_from and
//   identifiers/envelope_from — the message/message_header_from element
//   belongs to failure reports only. rua is a DNS record value and is
//   never present in the report XML.
// - ZIP archives are reverse-scanned from the central directory (immune
//   to signature bytes appearing in compressed data), entries are
//   iterated rather than assumed single, and non-XML filenames are
//   skipped.
// - All XML-derived values are escaped before innerHTML insertion.
//
// DOM acquisition and listener binding live in init() so ClientRouter
// soft navigation binds fresh elements; the dataset guard prevents
// duplicate listeners.

  // DOM references, populated by init() — acquired fresh on every page load
  // event so soft-navigated pages bind to their own (new) elements.
  let fields: {
    file: HTMLInputElement;
    parseBtn: HTMLButtonElement;
    loading: HTMLElement;
    results: HTMLElement;
    error: HTMLElement;
    errorText: HTMLElement;
  };

  // Escape untrusted strings before inserting into innerHTML
  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // Basic validation — reject clearly non-matches early
  function validateFile(file: File): string | null {
    const ext = file.name.split('.').pop()?.toLowerCase();
    if (!ext || !(ext === 'xml' || ext === 'gz' || file.name.endsWith('.zip'))) {
      return 'File must be .xml, .xml.gz, or .zip';
    }
    if (file.size > 10 * 1024 * 1024) {
      return 'Report file too large (max 10MB)';
    }
    return null;
  }

  // Decompress gzip blob to text
  async function decompressGzip(blob: Blob): Promise<string> {
    const stream = blob.stream().pipeThrough(new DecompressionStream('gzip'));
    const decompressed = await new Response(stream).text();
    return decompressed;
  }

  // Minimal ZIP reader — v1.4 hardened.
  // Reverse-scans for the End Of Central Directory record, walks the central
  // directory entries from the last entry backwards, and returns the first
  // entry whose filename ends with .xml. Entries whose filename is not .xml
  // are skipped; entries that require decompression are skipped with a clear
  // error only if no usable .xml entry exists at all.
  async function unzipFirstXml(buffer: ArrayBuffer): Promise<string> {
    const decoder = new TextDecoder();
    const view = new DataView(buffer);

    // --- Locate End Of Central Directory (EOCD) by scanning backwards ---
    // EOCD signature 0x06054b50 sits at the very end of the file (within
    // the 22-byte record plus any trailing comment). Scanning backwards
    // from the tail is robust against signature bytes appearing inside
    // compressed data, and finds the real EOCD rather than a mimic.
    const minEocdOffset = Math.max(0, buffer.byteLength - 22 - 65535); // EOCD + max comment
    let eocdOffset = -1;
    for (let offset = buffer.byteLength - 22; offset >= minEocdOffset; offset--) {
      if (view.getUint32(offset, true) === 0x06054b50) {
        eocdOffset = offset;
        break;
      }
    }
    if (eocdOffset === -1) {
      throw new Error('ZIP structure not recognised (no end-of-central-directory record)');
    }

    // --- Read central directory location from EOCD ---
    const entryCount = view.getUint16(eocdOffset + 10, true);
    const cdOffset = view.getUint32(eocdOffset + 16, true);

    // --- Walk central directory entries, validate filenames ---
    // Central directory file header layout (PKZIP APPNOTE):
    //   +0  signature 0x02014b50
    //   +28 filename length
    //   +30 extra field length
    //   +32 comment length
    //   +42 local header offset
    //   +46 filename
    const byteView = new Uint8Array(buffer);
    let entryOffset = cdOffset;
    let lastNonXmlReason = '';
    let sawEntry = false;

    for (let i = 0; i < entryCount; i++) {
      if (entryOffset + 46 > buffer.byteLength ||
          view.getUint32(entryOffset, true) !== 0x02014b50) {
        throw new Error('ZIP central directory is corrupt or truncated');
      }
      sawEntry = true;

      const fileNameLen = view.getUint16(entryOffset + 28, true);
      const extraLen = view.getUint16(entryOffset + 30, true);
      const commentLen = view.getUint16(entryOffset + 32, true);
      const localHeaderOffset = view.getUint32(entryOffset + 42, true);

      const fileName = decoder
        .decode(byteView.subarray(entryOffset + 46, entryOffset + 46 + fileNameLen))
        .toLowerCase();

      // --- Filename validation: only .xml entries are extracted ---
      if (fileName.endsWith('.xml')) {
        // --- Jump to the local file header for this entry ---
        // Local file header layout:
        //   +0  signature 0x04034b50
        //   +8  compression method
        //   +22 uncompressed size
        //   +26 filename length
        //   +28 extra field length
        //   +30 data begins
        if (localHeaderOffset + 30 > buffer.byteLength ||
            view.getUint32(localHeaderOffset, true) !== 0x04034b50) {
          throw new Error('Local file header signature invalid');
        }

        const localFileNameLen = view.getUint16(localHeaderOffset + 26, true);
        const localExtraLen = view.getUint16(localHeaderOffset + 28, true);
        const localDataOffset = localHeaderOffset + 30 + localFileNameLen + localExtraLen;
        const uncompressedSize = view.getUint32(localHeaderOffset + 22, true);
        const compressionMethod = view.getUint16(localHeaderOffset + 8, true);

        if (compressionMethod !== 0) {
          lastNonXmlReason = 'compressed entries inside ZIP are not supported';
          continue; // keep looking for a stored .xml entry
        }

        if (localDataOffset + uncompressedSize > buffer.byteLength) {
          throw new Error('ZIP entry extends beyond the archive (corrupt file)');
        }

        const dataView = new Uint8Array(buffer, localDataOffset, uncompressedSize);
        return decoder.decode(dataView);
      }

      // Advance to the next central directory entry
      entryOffset += 46 + fileNameLen + extraLen + commentLen;
    }

    // Reached the end without extracting anything.
    if (!sawEntry) {
      throw new Error('ZIP archive contains no readable entries');
    }
    throw new Error(
      lastNonXmlReason
        ? 'No .xml file found in this ZIP (' + lastNonXmlReason + ')'
        : 'No .xml file found in this ZIP archive'
    );
  }

  // Extract XML content from file based on extension
  async function extractXml(file: File): Promise<string> {
    const buf = await file.arrayBuffer();
    const blob = new Blob([buf]);

    if (file.name.endsWith('.gz')) {
      return decompressGzip(blob);
    } else if (file.name.endsWith('.zip')) {
      return unzipFirstXml(buf);
    } else {
      return await blob.text();
    }
  }

  // Collect distinct sending domains for a record — envelope_from is the
  // SMTP-level source, header_from is the From: the recipient saw. Both are
  // shown: when they differ, that difference is itself diagnostic.
  function collectSendingDomains(rec: Element): string[] {
    const domains = new Set<string>();
    rec.querySelectorAll('identifiers > header_from').forEach(el => {
      const v = el.textContent?.trim();
      if (v) domains.add(v);
    });
    rec.querySelectorAll('identifiers > envelope_from').forEach(el => {
      const v = el.textContent?.trim();
      if (v) domains.add(v);
    });
    return Array.from(domains);
  }

  // Parse DMARC aggregate XML — RFC 7489 structure
  function parseDmarcXml(xmlStr: string): {
    policy_published: { domain: string; adkim: string; aspf: string; p: string; pct: number };
    records: Array<{
      row: { source_ip: string; count: number; policy_evaluated: { disposition: string; dkim: string; spf: string } };
      sending_domains: string[];
    }>;
  } | null {
    try {
      const parser = new DOMParser();
      const doc = parser.parseFromString(xmlStr, 'application/xml');

      const feedback = doc.querySelector('feedback');
      if (!feedback) return null;

      const policyPublished = feedback.querySelector('policy_published');
      if (!policyPublished) return null;

      const policy = {
        domain: policyPublished.querySelector('domain')?.textContent || '',
        adkim: policyPublished.querySelector('adkim')?.textContent || 'r',
        aspf: policyPublished.querySelector('aspf')?.textContent || 'r',
        p: policyPublished.querySelector('p')?.textContent || 'none',
        pct: parseInt(policyPublished.querySelector('pct')?.textContent || '100', 10),
      };

      const records: any[] = [];
      feedback.querySelectorAll('record').forEach(rec => {
        const row = rec.querySelector('row');
        if (row) {
          records.push({
            row: {
              source_ip: row.querySelector('source_ip')?.textContent || '',
              count: parseInt(row.querySelector('count')?.textContent || '0', 10),
              policy_evaluated: {
                disposition: row.querySelector('policy_evaluated > disposition')?.textContent || 'none',
                dkim: row.querySelector('policy_evaluated > dkim')?.textContent || 'fail',
                spf: row.querySelector('policy_evaluated > spf')?.textContent || 'fail',
              },
            },
            sending_domains: collectSendingDomains(rec),
          });
        }
      });

      return { policy_published: policy, records };
    } catch {
      return null;
    }
  }

  // Aggregate data by source IP for summarised table
  function summariseRecords(records: any[]) {
    const summary: Map<string, { total: number; spf_pass: number; dkim_pass: number; quarantined: number; rejected: number; sending_domains: Set<string> }> = new Map();
    for (const rec of records) {
      const ip = rec.row.source_ip;
      const entry = summary.get(ip) || { total: 0, spf_pass: 0, dkim_pass: 0, quarantined: 0, rejected: 0, sending_domains: new Set<string>() };
      entry.total += rec.row.count;
      if (rec.row.policy_evaluated.spf === 'pass') entry.spf_pass += rec.row.count;
      if (rec.row.policy_evaluated.dkim === 'pass') entry.dkim_pass += rec.row.count;
      if (rec.row.policy_evaluated.disposition === 'quarantine') entry.quarantined += rec.row.count;
      if (rec.row.policy_evaluated.disposition === 'reject') entry.rejected += rec.row.count;
      for (const from of rec.sending_domains || []) entry.sending_domains.add(from);
      summary.set(ip, entry);
    }
    return Array.from(summary.entries())
      .sort((a, b) => b[1].total - a[1].total)
      .slice(0, 10);
  }

  // Plain-English verdict generator
  function generateVerdict(parsed: { policy_published: any; records: any[] }): string {
    const policy = parsed.policy_published;
    const totalMessages = parsed.records.reduce((sum, r) => sum + r.row.count, 0);
    const passingCount = parsed.records.filter(r => r.row.policy_evaluated.dkim === 'pass' || r.row.policy_evaluated.spf === 'pass').reduce((sum, r) => sum + r.row.count, 0);
    const passRate = totalMessages > 0 ? Math.round((passingCount / totalMessages) * 100) : 0;
    const quarantinedCount = parsed.records.reduce((sum, r) => sum + (r.row.policy_evaluated.disposition === 'quarantine' ? r.row.count : 0), 0);
    const rejectedCount = parsed.records.reduce((sum, r) => sum + (r.row.policy_evaluated.disposition === 'reject' ? r.row.count : 0), 0);
    const sourceCount = new Set(parsed.records.map(r => r.row.source_ip)).size;

    const policyLabels = { none: 'monitoring', quarantine: 'quarantine suspicious mail', reject: 'reject failures' };
    const policyLabel = policyLabels[policy.p as keyof typeof policyLabels] || policy.p;

    let verdict = `Policy is set to ${policyLabel} across ${sourceCount} reported sources. Approximately ${passRate}% of sampled messages pass authentication.`;

    if (quarantinedCount > 0 || rejectedCount > 0) {
      const actions: string[] = [];
      if (quarantinedCount > 0) actions.push(`${quarantinedCount.toLocaleString()} message${quarantinedCount !== 1 ? 's' : ''} quarantined`);
      if (rejectedCount > 0) actions.push(`${rejectedCount.toLocaleString()} message${rejectedCount !== 1 ? 's' : ''} rejected`);
      verdict += ` Enforcement acted on ${actions.join(' and ')} in this report.`;
    }

    return verdict;
  }

  // Interpretation layer
  function generateInterpretation(parsed: { policy_published: any; records: any[] }): string {
    const policy = parsed.policy_published;

    if (policy.p === 'none') {
      return 'Your DMARC policy is set to monitor — the provider reports are informational, not enforcement. If you see unexpected sources in this report, that\'s the signal to tighten the policy once you\'ve identified them.';
    } else if (policy.p === 'quarantine') {
      const failing = parsed.records.filter(r => r.row.policy_evaluated.disposition === 'quarantine').length;
      if (failing > 0) {
        return 'Quarantine policy is active — suspicious mail is being diverted. This is a midpoint between monitoring and rejection, appropriate while you verify all legitimate sources pass.';
      }
      return 'Quarantine policy is active with no quarantined samples in this report. The next step is typically to move to reject if all sources remain consistent.';
    } else {
      return 'Reject policy is enforced — failures are rejected outright. Ensure all legitimate senders pass before enforcing this.';
    }
  }

  // Render results block — all XML-derived values escaped
  function renderResults(parsed: { policy_published: any; records: any[] }) {
    const verdict = generateVerdict(parsed);
    const interpretation = generateInterpretation(parsed);
    const summary = summariseRecords(parsed.records);
    const policy = parsed.policy_published;

    let html = `
      <div class="rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-4 mb-4">
        <h3 class="font-bold text-lg dark:text-white mb-2">Verdict</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300">${escapeHtml(verdict)}</p>
      </div>

      <div class="rounded-lg border border-slate-200 dark:border-slate-700 overflow-x-auto mb-4">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left border-b border-slate-200 dark:border-slate-700 dark:text-slate-300">
              <th class="p-3">Source IP</th>
              <th class="p-3">Sending domains</th>
              <th class="p-3 text-right">Messages</th>
              <th class="p-3 text-right">DKIM pass</th>
              <th class="p-3 text-right">SPF pass</th>
              <th class="p-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
    `;

    for (const [ip, data] of summary) {
      const spfRate = data.total > 0 ? Math.round((data.spf_pass / data.total) * 100) : 0;
      const dkimRate = data.total > 0 ? Math.round((data.dkim_pass / data.total) * 100) : 0;
      const domains = data.sending_domains.size ? Array.from(data.sending_domains).join(', ') : 'Not reported';
      const actions: string[] = [];
      if (data.quarantined > 0) actions.push(`${data.quarantined.toLocaleString()} quarantined`);
      if (data.rejected > 0) actions.push(`${data.rejected.toLocaleString()} rejected`);
      const actionsText = actions.length ? actions.join(', ') : 'None';
      html += `
          <tr class="border-b border-slate-100 dark:border-slate-800">
            <td class="p-3 dark:text-white">${escapeHtml(ip)}</td>
            <td class="p-3 dark:text-white">${escapeHtml(domains)}</td>
            <td class="p-3 text-right dark:text-white">${data.total.toLocaleString()}</td>
            <td class="p-3 text-right ${dkimRate < 50 ? 'text-red-600 dark:text-red-400 font-semibold' : ''}">${dkimRate}%</td>
            <td class="p-3 text-right ${spfRate < 50 ? 'text-red-600 dark:text-red-400 font-semibold' : ''}">${spfRate}%</td>
            <td class="p-3 text-right dark:text-white">${escapeHtml(actionsText)}</td>
          </tr>
      `;
    }

    html += `
          </tbody>
        </table>
      </div>

      <div class="rounded-lg bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-700 p-4 mb-4">
        <h3 class="font-bold text-lg dark:text-white mb-2">What this means</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300">${escapeHtml(interpretation)}</p>
      </div>

      <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-4">
        <h3 class="font-bold text-lg dark:text-white mb-2">Policy details</h3>
        <ul class="text-sm text-slate-600 dark:text-slate-300 space-y-1 list-disc pl-5">
          <li>Domain: <strong>${escapeHtml(policy.domain)}</strong></li>
          <li>Publish policy: <strong>${escapeHtml(policy.p)}</strong></li>
          <li>Alignment mode: DKIM ${policy.adkim === 's' ? 'strict' : 'relaxed'}, SPF ${policy.aspf === 's' ? 'strict' : 'relaxed'}</li>
        </ul>
      </div>
    `;

    fields.results.innerHTML = html;
    fields.results.classList.remove('hidden');
  }

  // Main handler
  async function handleParse() {
    const file = fields.file.files?.[0];
    fields.loading.classList.add('hidden');
    fields.results.classList.add('hidden');
    fields.error.classList.add('hidden');

    if (!file) {
      showError('No file selected');
      return;
    }

    const validationError = validateFile(file);
    if (validationError) {
      showError(validationError);
      return;
    }

    fields.loading.classList.remove('hidden');
    fields.parseBtn.disabled = true;

    try {
      const xmlStr = await extractXml(file);
      const parsed = parseDmarcXml(xmlStr);

      if (!parsed) {
        showError('Unable to parse this as a DMARC aggregate report — file format may be incorrect or corrupted.');
      } else {
        renderResults(parsed);
      }
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Failed to process file');
    } finally {
      fields.loading.classList.add('hidden');
      fields.parseBtn.disabled = false;
    }
  }

  function showError(msg: string) {
    fields.errorText.textContent = msg;
    fields.error.classList.remove('hidden');
  }

  // --- View Transitions binding (v1.5) — see header comment -----------------------
  function init() {
    const parseBtn = document.getElementById('parse-btn') as HTMLButtonElement | null;
    if (!parseBtn || parseBtn.dataset.initDone === 'true') return;
    parseBtn.dataset.initDone = 'true';

    fields = {
      file: document.getElementById('report-file') as HTMLInputElement,
      parseBtn,
      loading: document.getElementById('loading') as HTMLElement,
      results: document.getElementById('results') as HTMLElement,
      error: document.getElementById('error') as HTMLElement,
      errorText: document.getElementById('error-text') as HTMLElement,
    };

    parseBtn.addEventListener('click', handleParse);
  }

  const pageInit = (window as any).pageInit as ((fn: () => void) => void) | undefined;
  if (typeof pageInit === 'function') {
    pageInit(init);
  } else {
    // Fallback if the layout helper is ever absent: bind directly and
    // listen for astro:page-load ourselves (same guard makes this safe).
    init();
    document.addEventListener('astro:page-load', init);
  }
</script>
