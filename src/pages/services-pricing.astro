---
import Layout from '~/layouts/PageLayout.astro';

import CallToAction from '~/components/widgets/CallToAction.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Pricing',
  description:
    'Transparent pricing for MacDougall Email deliverability services — from automated DMARC monitoring to hands-on rescue work and ongoing advisory support.',
};

// Tier data lives here so pricing edits happen in one place.
// NOTE: if the audit/package figures change, update the ROI calculator
// constants (PACKAGE_FEE, TRIGGER_THRESHOLD) in the same pass.
const tiers = [
  {
    name: 'Sender Sentry',
    price: '£49',
    cadence: 'per month',
    summary:
      'Your domain, watched. I monitor your DMARC reports continuously and tell you when something changes — before it costs you.',
    features: [
      'Daily monitoring of your DMARC aggregate reports',
      'Plain-English summary of every sender acting as your domain',
      'Alerts when a new sender appears or authentication breaks',
      'Human review when something needs judgement, not just parsing',
      'No lock-in — cancel anytime',
    ],
    highlight: true,
  },
  {
    name: 'Wingman',
    price: '£99',
    cadence: 'per month',
    summary:
      'Direct WhatsApp access to an experienced email infrastructure consultant. Advice, not implementation — the decisions stay yours.',
    features: [
      'Ask me anything on WhatsApp about your sending, authentication or platform',
      'Advice and guidance only — I do not log in and change your systems',
      'Priority replies — typically same working day',
      'Limited places — advice quality depends on my availability, so capacity is capped',
    ],
    highlight: false,
  },
  {
    name: 'Authentication Audit',
    price: '£149',
    cadence: 'one-off',
    summary:
      'Full diagnostic of your current authentication. What is published, what passes, what fails, and why.',
    features: [
      'SPF, DKIM and DMARC records examined live against public DNS',
      'Lookup budget calculated and reported',
      'Plain-English summary of what is broken and what it costs you',
      'Prioritised remediation plan you can execute yourself',
    ],
    highlight: false,
  },
  {
    name: 'Deliverability Rescue',
    price: '£249',
    cadence: 'one-off',
    summary:
      'Your email is going to spam and you do not know why. I diagnose and fix it.',
    features: [
      'Complete investigation across all three layers',
      'Authentication records aligned and published for you',
      'Platform configuration corrected where required',
      'Verification tests proving the result',
    ],
    highlight: false,
  },
  {
    name: 'Custom Services',
    price: 'PoA',
    cadence: 'ongoing',
    summary:
      'Hands-on consulting and implementation work scoped to your requirements. Priced on application.',
    features: [
      'Scoped engagements with defined deliverables and timelines',
      'Configuration work performed for you, not just advised on',
      'Full quote provided before any commitment',
      'Includes everything Wingman deliberately excludes',
    ],
    highlight: false,
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero (default) -->

  <Hero
    id="hero"
    tagline="Pricing"
    title="Straightforward pricing"
    subtitle="No hourly rates, no surprise invoices. Pick the level of help you need — if it is not listed, the custom tier covers it."
    actions={[
      { variant: 'primary', text: 'Free Consultation', href: getPermalink('/consultation') },
      { variant: 'secondary', text: 'Services', href: getPermalink('/services') },
    ]}
  />

  <!-- Tiers (slate-100) -->

  <section id="pricing" class="relative py-12 sm:py-16">
    <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>

    <div class="relative px-4 sm:px-6 mx-auto lg:px-8 max-w-7xl">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {tiers.map((tier) => (
          <div
            class={`relative flex flex-col rounded-2xl shadow-lg border p-6 ${
              tier.highlight
                ? 'bg-white dark:bg-slate-900 border-primary'
                : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700'
            }`}
          >
            {tier.highlight && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-semibold px-3 py-1 rounded-full">
                Most Popular
              </span>
            )}
            <h3 class="text-lg font-bold dark:text-white">{tier.name}</h3>
            <p class="mt-3">
              <span class="text-3xl font-extrabold dark:text-white">{tier.price}</span>
              <span class="text-sm text-slate-600 dark:text-slate-300"> {tier.cadence}</span>
            </p>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">{tier.summary}</p>
            <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-300 flex-1">
              {tier.features.map((feature) => (
                <li class="flex gap-2">
                  <span aria-hidden="true">&#10003;</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <a
              href="/contact"
              class={`btn ${tier.highlight ? 'btn-primary' : 'btn-outline'} rounded-lg px-5 py-2.5 font-medium mt-6 text-center whitespace-nowrap`}
            >
              Enquire
            </a>
          </div>
        ))}
      </div>

      <p class="text-center text-xs text-slate-600 dark:text-slate-400 mt-6">
        Pricing shown is indicative. Confirm the current structure before engaging.
      </p>
    </div>
  </section>

  <!-- Which ongoing service (default) -->

  <section class="relative py-12 sm:py-16">
    <div class="px-4 sm:px-6 mx-auto lg:px-8 max-w-3xl">
      <h2 class="text-2xl font-bold dark:text-white sm:text-3xl text-center">Sentry, Wingman or Custom?</h2>
      <div class="mt-8 space-y-6 text-slate-600 dark:text-slate-300">
        <p>
          Sentry is watching. Your domain's DMARC reports are read every day, and you hear about it
          when something changes — a new sender, a broken alignment, a spike in failures. It is
          monitoring, not advice: it tells you what is happening, not what to do about it.
        </p>
        <p>
          Wingman is advice on WhatsApp. It is a subscription: you ask, I answer, the decisions and
          the hands on the keyboard stay with you. Best when you know roughly what to do and want
          an experienced opinion before you do it.
        </p>
        <p>
          Custom is work. Requirements, configuration, implementation, documentation — scoped
          properly, quoted before anything starts, delivered by me. Best when the problem needs
          someone to actually fix it.
        </p>
        <p>
          The Brief, the free and paid newsletter, is priced separately — see
          <a href="/brief" class="underline">The Brief</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Call to action (slate-100) -->

  <CallToAction
    title="Not sure which tier fits?"
    subtitle="Describe the problem — I will tell you which level of help it actually needs."
    actions={[
      { variant: 'primary', text: 'Book Your Free Consultation', href: getPermalink('/consultation') },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-100 dark:bg-transparent"></div>
    </Fragment>
  </CallToAction>

  <!-- Blog (default, last before footer) -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Straightforward guides and updates on authentication, deliverability and overall strategy."
  />
</Layout>
