---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact',
  description:
    'Get in touch about email authentication audits, deliverability work, managed Mautic hosting or ongoing consulting.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Contact"
    title="Tell me where your email is landing"
    subtitle="Describe the problem in a paragraph or two — what's going wrong, what platform you send from, and roughly how many emails per month. I'll tell you straight whether it's something I can fix and what it will cost."
    actions={[
      {
        variant: 'primary',
        text: 'Email me direct',
        href: 'mailto:alan@macdougallsystems.com',
      },
      {
        variant: 'secondary',
        target: '_blank',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/UPWORK_URL',
      },
    ]}
  />

  <Content
    isReversed
    items={[
      {
        title: 'Email',
        description:
          'alan@macdougallsystems.com — for retainers, managed hosting and everything booked direct. I aim to reply within one working day.',
        icon: 'tabler:mail',
      },
      {
        title: 'Upwork',
        description:
          'Preferred for fixed-scope project work — audits, deliverability rescues and migrations. Contracts, payments and messaging in one place.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'What happens next',
        description:
          'I reply with questions, you answer them, and you get a fixed price before anything changes. No surprises, no hourly creep.',
        icon: 'tabler:route',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">How to reach me</h3>
      <p>
        Two doors. Project work goes through Upwork; everything else — retainers, managed Mautic hosting,
        consulting — comes straight to me. Either way you get the same person and the same standard of work.
      </p>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Email me direct',
        href: 'mailto:alan@macdougallsystems.com',
      },
      {
        variant: 'secondary',
        target: '_blank',
        text: 'Hire me on Upwork',
        href: 'https://www.upwork.com/freelancers/UPWORK_URL',
      },
    ]}
    title="A conversation is free"
    subtitle="Describe the problem. If I can fix it, you'll know what it costs before you commit."
  />
</Layout>
